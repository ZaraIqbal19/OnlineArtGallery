@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Register confirmation";
}

<style>
    .confirm-container {
        max-width: 480px;
        margin: 60px auto;
        padding: 40px 32px;
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(111, 168, 0, 0.12);
        text-align: center;
        border: 1px solid #d4f09b;
        animation: fadeIn 0.5s ease;
        position: relative;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .confirm-icon {
        width: 80px;
        height: 80px;
        margin: 0 auto 20px;
        animation: float 3s ease-in-out infinite;
    }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-8px);
        }
    }

    .confirm-container h1 {
        color: #6fa800;
        font-size: 1.6rem;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .confirm-subtext {
        color: #5a5a5a;
        font-size: 0.95rem;
        margin-bottom: 4px;
    }

    .email-highlight {
        color: #6fa800;
        font-weight: 700;
    }

    .expiry-note {
        display: inline-block;
        margin-top: 12px;
        font-size: 0.8rem;
        color: #6fa800;
        background: #f0fae6;
        border: 1px solid #d4f09b;
        padding: 6px 14px;
        border-radius: 20px;
    }

    .sender-preview {
        margin-top: 16px;
        text-align: left;
        background: #f0fae6;
        border: 1px solid #d4f09b;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.8rem;
        color: #5a5a5a;
    }

        .sender-preview b {
            color: #333;
        }

    .status-line {
        display: inline-flex;
        align-items: center;
        font-size: 0.85rem;
        color: #6fa800;
        margin-top: 14px;
    }

    .pulse-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #88d200;
        margin-right: 6px;
        animation: pulse 1.6s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 0 0 0 rgba(136,210,0,0.5);
        }

        70% {
            box-shadow: 0 0 0 8px rgba(136,210,0,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(136,210,0,0);
        }
    }

    hr.divider {
        margin: 24px 0;
        border: none;
        border-top: 1px solid #f0fae6;
    }

    .client-buttons {
        display: flex;
        gap: 10px;
        margin-bottom: 18px;
    }

    .client-btn {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 8px;
        border-radius: 8px;
        border: 1px solid #d4f09b;
        background: #fff;
        color: #4a4a4a;
        font-size: 0.8rem;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
        position: relative;
        overflow: hidden;
    }

        .client-btn:hover {
            border-color: #6fa800;
            color: #6fa800;
            transform: translateY(-2px);
            box-shadow: 0 6px 14px rgba(111,168,0,0.15);
        }

    .confirm-btn-home {
        display: inline-block;
        padding: 10px 28px;
        background: #88d200;
        color: #fff;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.2s ease;
        position: relative;
        overflow: hidden;
    }

        .confirm-btn-home:hover {
            background: #6fa800;
            color: #fff;
        }

    .ripple {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.6);
        transform: scale(0);
        animation: rippleAnim 0.6s linear;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(3);
            opacity: 0;
        }
    }

    .toast {
        position: fixed;
        bottom: 24px;
        left: 50%;
        transform: translateX(-50%) translateY(20px);
        background: #333;
        color: #fff;
        padding: 12px 22px;
        border-radius: 8px;
        font-size: 0.85rem;
        opacity: 0;
        transition: all 0.3s ease;
        z-index: 10;
    }

        .toast.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
</style>

<div class="confirm-container">
    <svg class="confirm-icon" viewBox="0 0 200 200" fill="none">
        <circle cx="100" cy="100" r="90" fill="#f0fae6" />
        <rect x="45" y="65" width="110" height="75" rx="8" fill="#fff" stroke="#88d200" stroke-width="3" />
        <path d="M45 70l55 40 55-40" stroke="#88d200" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
        <circle cx="150" cy="60" r="18" fill="#88d200" />
        <path d="M142 60l6 6 12-12" stroke="#fff" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round" />
    </svg>

    <h1>Check your inbox</h1>
    <p class="confirm-subtext">We've sent a verification link to <span class="email-highlight">@Model.MaskedEmail</span></p>
    <p class="confirm-subtext">Click the link in that email to activate your account.</p>

    <div class="expiry-note">⏳ This link expires in 24 hours</div>

    <div class="sender-preview">
        <b>From:</b> YourApp &lt;noreply@yourapp.com&gt;<br />
        <b>Subject:</b> Confirm your account
    </div>

    <div id="statusLine" class="status-line"><span class="pulse-dot"></span> Waiting for confirmation&hellip;</div>

    <hr class="divider" />

    <div class="client-buttons">
        <a href="https://mail.google.com" target="_blank" class="client-btn">📧 Gmail</a>
        <a href="https://outlook.live.com/mail/0/inbox" target="_blank" class="client-btn">📨 Outlook</a>
        <a href="https://mail.yahoo.com" target="_blank" class="client-btn">✉️ Yahoo</a>
    </div>

    <p style="font-size:0.85rem; color:#5a5a5a;">Didn't get the email?</p>
    <a class="confirm-btn-home" href="/Identity/Account/ResendEmailConfirmation" id="resendLink">Resend verification email</a>
</div>

<div class="toast" id="toast">Redirecting...</div>

<script>
    (function () {
        var email = @Html.Raw(Json.Serialize(Model.Email));

        document.querySelectorAll('.confirm-btn-home, .client-btn').forEach(function (btn) {
            btn.addEventListener('click', function (e) {
                var rect = btn.getBoundingClientRect();
                var ripple = document.createElement('span');
                ripple.className = 'ripple';
                var size = Math.max(rect.width, rect.height);
                ripple.style.width = ripple.style.height = size + 'px';
                ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
                ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
                btn.appendChild(ripple);
                setTimeout(function () { ripple.remove(); }, 600);
            });
        });

        if (email) {
            var pollInterval = setInterval(function () {
                fetch('?handler=EmailStatus&email=' + encodeURIComponent(email))
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data.confirmed) {
                            clearInterval(pollInterval);
                            document.getElementById('statusLine').innerHTML = '✅ Confirmed! Redirecting&hellip;';
                            var toast = document.getElementById('toast');
                            toast.classList.add('show');
                            setTimeout(function () {
                                window.location.href = '/Identity/Account/Login';
                            }, 1200);
                        }
                    })
                    .catch(function () { /* keep polling silently */ });
            }, 4000);
        }
    })();
</script>