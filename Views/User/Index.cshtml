<!-- Start stats Area -->
<section class="stats-area">
	<div class="container">
		<div class="row">
			<div class="col-6 col-md-3 stat-item reveal">
				<div class="stat-number">@ViewBag.TotalArtworks<span class="stat-accent">+</span></div>
				<div class="stat-label">Artworks Listed</div>
			</div>
			<div class="col-6 col-md-3 stat-item reveal">
				<div class="stat-number">@ViewBag.TotalCollections</div>
				<div class="stat-label">Curated Collections</div>
			</div>
			<div class="col-6 col-md-3 stat-item reveal">
				<div class="stat-number">@ViewBag.TotalCategories</div>
				<div class="stat-label">Curated Categories</div>
			</div>
			<div class="col-6 col-md-3 stat-item reveal">
				<div class="stat-number">@ViewBag.TotalReviews<span class="stat-accent">+</span></div>
				<div class="stat-label">Visitor Reviews</div>
			</div>
		</div>
	</div>
</section>
<!-- End stats Area -->
<!-- Start quote Area -->
<section class="quote-area section-gap">
	<div class="container">
		<div class="row">
			<div class="col-lg-6 quote-left reveal">
				<h1>
					Every <span>canvas</span> holds a conversation <br>
					between silence and <span>color</span> — step closer, <br>
					and let it <span>speak</span>.
				</h1>
			</div>
			<div class="col-lg-6 quote-right reveal">
				<p>
					We built this gallery to close the distance between artists and the people
					who fall in love with their work. Every piece here is listed directly by
					its creator — no middlemen, no markups you can't trace. Whether you're
					furnishing a first apartment or adding to a lifelong collection, you're
					buying straight from the source.
				</p>
			</div>
		</div>
	</div>
</section>
<!-- End quote Area -->
<!-- Start Buy Now Area -->
<section class="buynow-section-bg section-gap" id="exhibitions">
	<div class="container">
		<div class="row d-flex justify-content-center">
			<div class="menu-content pb-50 col-lg-10">
				<div class="title text-center section-heading-wrap reveal">
					<span class="gal-eyebrow buy-eyebrow"><i class="bi bi-bag-check-fill"></i>&nbsp; Ready to Own</span>
					<h1 class="mb-10 gal-heading">Buy Now Collection</h1>
					<p class="gal-sub">Take a piece home today — no waiting, no bidding, just yours.</p>
					<div class="section-underline buy"></div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="pgrid col-12">
				@{
					bool anyBuy = false;
				}
				@if (ViewBag.FeaturedExhibits != null && ((System.Collections.IEnumerable)ViewBag.FeaturedExhibits).GetEnumerator().MoveNext())
				{
					@foreach (var product in ViewBag.FeaturedExhibits)
					{
						bool isBid = product.AvailableForBid == "Yes";
						if (isBid) { continue; }
						anyBuy = true;
						decimal displayPrice = (decimal)product.price;
						<div class="home-product-card buynow-card reveal">
							<div class="home-product-card__media">
								<img src="@product.Image1" alt="@product.Name">
								<div class="home-product-card__shine"></div>
								<span class="home-product-card__badge buy"><i class="bi bi-bag-check"></i> Buy Now</span>
								<a href="/User/Viewproductdetails/@product.Id" class="home-product-card__view-btn"><i class="bi bi-eye"></i> Quick View</a>
							</div>
							<div class="home-product-card__body">
								<a href="/User/Viewproductdetails/@product.Id" style="text-decoration:none;">
									<p class="home-product-card__title">@product.Name</p>
								</a>
								<p class="home-product-card__category buy-cat">@product.SubCategory?.category?.Name — @product.SubCategory?.Name</p>
								<div class="home-product-card__meta">
									<span class="home-product-card__price buy-price">@displayPrice.ToString("C")</span>
								</div>
								<a href="/User/Placeorder/@product.Id" class="home-btn-action buy"><i class="bi bi-bag-check"></i> Buy Now</a>
							</div>
						</div>
					}
				}
				@if (!anyBuy)
				{
					<p class="no-items-msg"><i class="bi bi-bag"></i>New Buy Now pieces will appear here as artists list their work.</p>
				}
			</div>
		</div>
	</div>
</section>
<!-- End Buy Now Area -->
<!-- Start Live Auctions Area -->
<section class="auction-section-bg section-gap">
	<div class="container">
		<div class="row d-flex justify-content-center">
			<div class="menu-content pb-50 col-lg-10">
				<div class="title text-center section-heading-wrap reveal">
					<span class="gal-eyebrow auc-eyebrow"><i class="bi bi-hammer"></i>&nbsp; Bidding Now Open</span>
					<h1 class="mb-10 gal-heading">Live Auctions</h1>
					<p class="gal-sub">Rare and limited pieces — place your bid before time runs out.</p>
					<div class="section-underline auc"></div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="pgrid col-12">
				@{
					bool anyBid = false;
				}
				@if (ViewBag.FeaturedExhibits != null && ((System.Collections.IEnumerable)ViewBag.FeaturedExhibits).GetEnumerator().MoveNext())
				{
					@foreach (var product in ViewBag.FeaturedExhibits)
					{
						bool isBid = product.AvailableForBid == "Yes";
						if (!isBid) { continue; }
						anyBid = true;
						decimal displayPrice = (decimal)product.BidPrice;
						<div class="home-product-card auction-card reveal">
							<div class="home-product-card__media">
								<img src="@product.Image1" alt="@product.Name">
								<div class="home-product-card__shine"></div>
								<span class="home-product-card__badge bid"><i class="bi bi-hammer"></i> On Bid</span>
								<a href="/User/Viewproductdetails/@product.Id" class="home-product-card__view-btn"><i class="bi bi-eye"></i> Quick View</a>
							</div>
							<div class="home-product-card__body">
								<a href="/User/Viewproductdetails/@product.Id" style="text-decoration:none;">
									<p class="home-product-card__title">@product.Name</p>
								</a>
								<p class="home-product-card__category auc-cat">@product.SubCategory?.category?.Name — @product.SubCategory?.Name</p>
								<span class="auc-countdown" data-auc-countdown="@product.BidEndDate.ToString("yyyy-MM-dd")T00:00:00">
									<i class="bi bi-clock-fill"></i> <span class="auc-countdown-text">calculating...</span>
								</span>
								<div class="home-product-card__meta">
									<div>
										<span class="home-product-card__price-label auc-price">Current bid</span>
										<span class="home-product-card__price auc-price">@displayPrice.ToString("C")</span>
									</div>
								</div>
								<a href="/User/Placebid/@product.Id" class="home-btn-action bid"><i class="bi bi-hammer"></i> Start Bidding</a>
							</div>
						</div>
					}
				}
				@if (!anyBid)
				{
					<p class="no-items-msg"><i class="bi bi-hammer"></i>New auction pieces will appear here as artists list their work.</p>
				}
			</div>
		</div>
	</div>
</section>
<!-- End Live Auctions Area -->
<!-- Start upcoming-event Area -->
<section class="upcoming-event-area section-gap" id="events">
	<div class="container">
		<div class="row d-flex justify-content-center">
			<div class="menu-content pb-60 col-lg-10">
				<div class="title text-center section-heading-wrap reveal">
					<span class="gal-eyebrow">Save the Date</span>
					<h1 class="mb-10 gal-heading">Checkout our Upcoming Events</h1>
					<p class="gal-sub">Meet artists in person and preview new arrivals before anyone else.</p>
					<div class="section-underline"></div>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-lg-6 event-left">
				<div class="single-events reveal">
					<img class="img-fluid" src="~/User/img/u1.jpg" alt="">
					<a href="#"><h4>Opening Night: New Arrivals</h4></a>
					<h6><span>First Saturday</span> at the Main Gallery Floor</h6>
					<p>
						A first look at the month's newest listings, with several artists on
						site to talk through their process and inspiration.
					</p>
					<a href="#" class="primary-btn text-uppercase">View Details</a>
				</div>
				<div class="single-events reveal">
					<img class="img-fluid" src="~/User/img/u3.jpg" alt="">
					<a href="#"><h4>Live Sketching Session</h4></a>
					<h6><span>Every Sunday</span> at the Courtyard Studio</h6>
					<p>
						Watch a working artist build a piece from a blank canvas, then ask
						questions about technique, materials, and pricing.
					</p>
					<a href="#" class="primary-btn text-uppercase">View Details</a>
				</div>
			</div>
			<div class="col-lg-6 event-right">
				<div class="single-events reveal">
					<a href="#"><h4>Collector's Preview Evening</h4></a>
					<h6><span>Last Friday</span> at the Main Gallery Floor</h6>
					<p>
						An early-access evening for returning collectors to view auction
						pieces before bidding opens to the public.
					</p>
					<a href="#" class="primary-btn text-uppercase">View Details</a>
					<img class="img-fluid" src="~/User/img/u2.jpg" alt="">
				</div>
				<div class="single-events reveal">
					<a href="#"><h4>Artist Talk & Q&A</h4></a>
					<h6><span>Third Wednesday</span> at the Reading Room</h6>
					<p>
						A relaxed conversation with a featured artist about their body of
						work, followed by an open floor for questions.
					</p>
					<a href="#" class="primary-btn text-uppercase">View Details</a>
					<img class="img-fluid" src="~/User/img/u4.jpg" alt="">
				</div>
			</div>
		</div>
	</div>
</section>
<!-- End upcoming-event Area -->
<!-- Start reviews Area -->
<section class="reviews-area section-gap" id="reviews">
	<div class="container">
		<div class="row d-flex justify-content-center">
			<div class="menu-content pb-70 col-lg-8">
				<div class="title text-center section-heading-wrap reveal">
					<span class="gal-eyebrow">In Their Words</span>
					<h1 class="mb-10 gal-heading">Visitor & Collector Reviews</h1>
					<p class="gal-sub">Real feedback from collectors who've bought, bid on, or walked through our gallery.</p>
					<div class="section-underline"></div>
				</div>
			</div>
		</div>
		<div class="row">
			@if (ViewBag.Feedbacks != null && ((System.Collections.IEnumerable)ViewBag.Feedbacks).GetEnumerator().MoveNext())
			{
				@foreach (var fb in ViewBag.Feedbacks)
				{
					var displayName = fb.User?.UserName ?? "Anonymous visitor";
					var initial = displayName.Length > 0 ? displayName[0].ToString().ToUpper() : "?";
					<div class="col-lg-4 col-md-6 mb-4">
						<div class="review-card reveal">
							<div class="review-stars" aria-label="5 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
							<div class="review-quote-icon">&ldquo;</div>
							<p class="review-message">@fb.message</p>
							<div class="review-author">
								<div class="review-avatar">@initial</div>
								<div>
									<p class="review-author-name">@displayName</p>
									<p class="review-author-label">Verified visitor</p>
								</div>
							</div>
						</div>
					</div>
				}
			}
			else
			{
				<div class="col-12">
					<p class="review-empty">No reviews yet — be the first to share your experience.</p>
				</div>
			}
		</div>
	</div>
</section>
<!-- End reviews Area -->
<!-- Start gallery Area -->
<section class="gallery-area section-gap" id="gallery">
	<div class="container">
		<div class="row d-flex justify-content-center">
			<div class="menu-content pb-70 col-lg-8">
				<div class="title text-center reveal">
					<span class="gal-eyebrow">A Closer Look</span>
					<h1 class="mb-10 text-white gal-heading" style="color:#fff;">Our Exhibition Gallery</h1>
					<p>Brushstrokes, textures, and details from pieces recently added to our collection.</p>
				</div>
			</div>
		</div>
		<div id="grid-container" class="row">
			@if (ViewBag.GalleryImages != null && ((System.Collections.IEnumerable)ViewBag.GalleryImages).GetEnumerator().MoveNext())
			{
				@foreach (var product in ViewBag.GalleryImages)
				{
					<a class="single-gallery" href="@product.Image1"><img class="grid-item" src="@product.Image1"></a>
				}
			}
			else
			{
				<p class="subcat-empty text-center w-100 text-white">Gallery images will appear here once artworks are listed.</p>
			}
		</div>
	</div>
</section>
<!-- End gallery Area -->