@{
}
@{
	Layout = "~/Views/Shared/_UserLayout.cshtml";
}

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@400;500;600&family=Cormorant+Garamond:ital,wght@1,500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
	/* ============================================================
				   Museum-placard design system (scoped to this page only)
				   ============================================================ */
	:root {
		--gal-ink: #1F2A24;
		--gal-ink-2: #26332C;
		--gal-brass: #B08D57;
		--gal-brass-light: #D3B57E;
		--gal-brass-dark: #8C6D3F;
		--gal-paper: #F3EFE6;
		--gal-paper-2: #EAE3D3;
		--gal-charcoal: #2B2B28;
		--gal-muted: #8B8A82;
		--gal-line: rgba(31,42,36,.10);
		--font-display: 'Playfair Display', Georgia, serif;
		--font-body: 'Inter', -apple-system, sans-serif;
		--font-caption: 'Cormorant Garamond', Georgia, serif;
		/* buy-now green */
		--shop-green: #88d200;
		--shop-dark-green: #6fa800;
		--shop-light-green: #d4f09b;
		--shop-ultra-light-green: #f0fae6;
		/* auction amber/red — urgency identity, distinct from buy-now */
		--auc-amber: #d98c00;
		--auc-amber-dark: #a86400;
		--auc-red: #c23b3b;
		--auc-red-dark: #962c2c;
		--auc-cream: #fdf3e2;
		--auc-cream-2: #f7e6c4;
	}

	.gal-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		font-family: var(--font-body);
		font-size: 12px;
		font-weight: 600;
		letter-spacing: .18em;
		text-transform: uppercase;
		color: var(--gal-brass-dark);
		border: 1px solid rgba(176,141,87,.4);
		padding: 6px 16px;
		border-radius: 2px;
		margin-bottom: 18px;
	}

		.gal-eyebrow::before {
			content: "";
			width: 6px;
			height: 6px;
			background: var(--gal-brass);
			border-radius: 50%;
			display: inline-block;
			animation: eyebrowPulse 2.4s ease-in-out infinite;
		}

		.gal-eyebrow.auc-eyebrow {
			color: var(--auc-red-dark);
			border-color: rgba(194,59,59,.35);
		}

			.gal-eyebrow.auc-eyebrow::before {
				background: var(--auc-red);
			}

		.gal-eyebrow.buy-eyebrow {
			color: var(--shop-dark-green);
			border-color: rgba(136,210,0,.35);
		}

			.gal-eyebrow.buy-eyebrow::before {
				background: var(--shop-green);
			}

	@@keyframes eyebrowPulse {
		0%, 100% {
			transform: scale(1);
			opacity: 1;
		}

		50% {
			transform: scale(1.4);
			opacity: .6;
		}
	}

	.gal-heading {
		font-family: var(--font-display);
		font-weight: 700;
		color: var(--gal-charcoal);
		letter-spacing: -.01em;
	}

	.gal-sub {
		font-family: var(--font-body);
		color: var(--gal-muted);
		max-width: 560px;
		margin-left: auto;
		margin-right: auto;
	}

	.gal-divider {
		width: 46px;
		height: 2px;
		background: var(--gal-brass);
		margin: 18px auto 0;
		position: relative;
		overflow: hidden;
	}

	.section-heading-wrap {
		position: relative;
	}

	.section-underline {
		width: 0;
		height: 3px;
		border-radius: 3px;
		margin: 14px auto 0;
		background: linear-gradient(90deg, var(--gal-brass), var(--gal-brass-light));
	}

	.js-motion .section-heading-wrap.reveal.is-visible .section-underline {
		animation: growUnderline .8s cubic-bezier(.2,.8,.25,1) .1s forwards;
	}

	.section-underline.buy {
		background: linear-gradient(90deg, var(--shop-dark-green), var(--shop-green));
	}

	.section-underline.auc {
		background: linear-gradient(90deg, var(--auc-red-dark), var(--auc-amber));
	}

	@@keyframes growUnderline {
		to {
			width: 64px;
		}
	}

	/* ---- Service cards ---- */
	.single-service {
		transition: transform .35s cubic-bezier(.2,.8,.25,1), box-shadow .35s ease;
		border-radius: 12px;
		position: relative;
	}

		.single-service:hover {
			transform: translateY(-8px);
			box-shadow: 0 20px 40px -20px rgba(0,0,0,.25);
		}

		.single-service .lnr {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 64px;
			height: 64px;
			border-radius: 50%;
			background: rgba(31,42,36,.06);
			font-size: 26px;
			margin-bottom: 18px;
			color: var(--gal-ink);
			transition: background .3s ease, color .3s ease, transform .3s ease;
		}

		.single-service:hover .lnr {
			background: var(--gal-brass);
			color: #fff;
			transform: rotate(-8deg) scale(1.08);
		}

	/* ============================================================
				   Subcategory area — museum wall backdrop
				   ============================================================ */
	.subcat-area {
		background: var(--gal-paper);
		background-image: linear-gradient(var(--gal-paper-2) 1px, transparent 1px), linear-gradient(90deg, var(--gal-paper-2) 1px, transparent 1px);
		background-size: 42px 42px;
		background-position: center;
	}

	.subcat-empty {
		color: var(--gal-muted);
		font-family: var(--font-body);
	}

	/* ============================================================
				   Shop-style subcategory cards
				   ============================================================ */
	.shop-cards-wrap {
		padding: 10px 4px 30px;
		perspective: 1200px;
	}

	.shop {
		position: relative;
		overflow: hidden;
		margin: 0;
		border-radius: 20px;
		height: 230px;
		cursor: pointer;
		box-shadow: 0 8px 24px rgba(0, 20, 4, 0.1);
		transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s ease;
		transform-style: preserve-3d;
		will-change: transform;
	}

		.shop:hover {
			transform: translateY(-8px) scale(1.015);
			box-shadow: 0 24px 48px rgba(0, 20, 4, 0.22);
		}

	.shop-media {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: var(--shop-ultra-light-green);
		overflow: hidden;
	}

		.shop-media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			display: block;
			transition: transform 0.7s cubic-bezier(0.2, 0.7, 0.3, 1), filter .5s ease;
			filter: saturate(1);
		}

	.shop:hover .shop-media img {
		transform: scale(1.12);
		filter: saturate(1.15);
	}

	.shop-panel {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: linear-gradient(135deg, var(--shop-green) 0%, var(--shop-dark-green) 55%, #3d6600 100%);
		clip-path: polygon(0 0, 62% 0, 46% 100%, 0 100%);
		pointer-events: none;
		transition: clip-path .45s cubic-bezier(.2,.8,.2,1);
	}

	.shop:hover .shop-panel {
		clip-path: polygon(0 0, 68% 0, 52% 100%, 0 100%);
	}

	.shop-shine {
		position: absolute;
		inset: 0;
		z-index: 3;
		background: linear-gradient(115deg, transparent 40%, rgba(255,255,255,0.45) 50%, transparent 60%);
		background-size: 220% 100%;
		background-position: -200% 0;
		opacity: 0;
		pointer-events: none;
	}

	.shop:hover .shop-shine {
		opacity: 1;
		animation: shineSweep 1s ease forwards;
	}

	@@keyframes shineSweep {
		to {
			background-position: 200% 0;
		}
	}

	.shop-content {
		position: absolute;
		inset: 0;
		z-index: 4;
		display: flex;
		flex-direction: column;
		justify-content: center;
		max-width: 58%;
		padding: 24px 16px 24px 26px;
		pointer-events: none;
	}

		.shop-content h3 {
			color: #fff;
			font-weight: 800;
			font-size: 21px;
			line-height: 1.28;
			margin: 0 0 18px;
			text-shadow: 0 2px 10px rgba(0,0,0,0.15);
			transition: transform .35s ease;
		}

	.shop:hover .shop-content h3 {
		transform: translateX(3px);
	}

	.shop-content .cta-btn {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		color: #fff;
		text-transform: uppercase;
		font-weight: 700;
		font-size: 12px;
		letter-spacing: 0.5px;
		white-space: nowrap;
		border: 1.5px solid rgba(255,255,255,0.7);
		border-radius: 30px;
		padding: 9px 18px;
		width: fit-content;
		text-decoration: none;
		transition: background 0.25s ease, transform 0.25s ease, gap .25s ease;
		pointer-events: auto;
	}

		.shop-content .cta-btn i {
			transition: transform .3s ease;
		}

		.shop-content .cta-btn:hover {
			background: rgba(255,255,255,0.2);
			transform: translateY(-2px);
			color: #fff;
			gap: 14px;
		}

			.shop-content .cta-btn:hover i {
				transform: translateX(3px);
			}

	.shop-count-badge {
		position: absolute;
		top: 14px;
		right: 14px;
		z-index: 5;
		display: inline-flex;
		align-items: center;
		gap: 5px;
		background: rgba(255,255,255,0.95);
		color: var(--shop-dark-green);
		font-size: 11px;
		font-weight: 700;
		padding: 5px 13px;
		border-radius: 20px;
		box-shadow: 0 4px 10px rgba(0,0,0,0.12);
		transition: transform .3s ease;
	}

	.shop:hover .shop-count-badge {
		transform: translateY(-2px) scale(1.05);
	}

	.shop-count-badge i {
		font-size: 9px;
	}

	@@media (max-width: 768px) {
		.shop {
			height: 200px;
		}

		.shop-content {
			max-width: 64%;
			padding: 18px 14px 18px 20px;
		}

			.shop-content h3 {
				font-size: 17px;
				margin-bottom: 14px;
			}

		.shop-panel {
			clip-path: polygon(0 0, 68% 0, 50% 100%, 0 100%);
		}
	}

	@@media (max-width: 576px) {
		.shop {
			height: 180px;
		}

		.shop-content h3 {
			font-size: 15px;
		}

		.shop-panel {
			clip-path: polygon(0 0, 78% 0, 55% 100%, 0 100%);
		}

		.shop-content {
			max-width: 74%;
		}
	}

	/* ============================================================
				   PRODUCT CARDS — shared base
				   ============================================================ */
	.product-split-area {
		background: var(--gal-paper);
		position: relative;
	}

	.product-tab-row {
		display: flex;
		justify-content: center;
		gap: 12px;
		margin-bottom: 6px;
	}

	.pgrid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
		gap: 26px;
		perspective: 1200px;
	}

	.home-product-card {
		position: relative;
		background: #fff;
		border-radius: 18px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		height: 100%;
		box-shadow: 0 4px 16px rgba(0,0,0,0.06);
		transition: transform .45s cubic-bezier(.2,.8,.2,1), box-shadow .45s ease;
		opacity: 0;
		transform: translateY(24px);
	}

	.js-motion .home-product-card.reveal.is-visible {
		opacity: 1;
		transform: translateY(0);
		animation: cardSettle .6s cubic-bezier(.2,.8,.25,1.05);
	}

	@@keyframes cardSettle {
		0% {
			opacity: 0;
			transform: translateY(24px) scale(.97);
		}

		60% {
			opacity: 1;
			transform: translateY(-4px) scale(1.005);
		}

		100% {
			opacity: 1;
			transform: translateY(0) scale(1);
		}
	}

	.home-product-card:hover {
		transform: translateY(-10px);
	}

	.home-product-card__media {
		position: relative;
		aspect-ratio: 4 / 3;
		overflow: hidden;
	}

		.home-product-card__media img {
			width: 100%;
			height: 100%;
			object-fit: cover;
			transition: transform .6s cubic-bezier(.2,.7,.3,1), filter .4s ease;
		}

	.home-product-card:hover .home-product-card__media img {
		transform: scale(1.13) rotate(.3deg);
	}

	.home-product-card__media::after {
		content: "";
		position: absolute;
		inset: 0;
		background: linear-gradient(180deg, rgba(0,0,0,0) 55%, rgba(0,0,0,0.4) 100%);
		opacity: 0;
		transition: opacity .35s ease;
	}

	.home-product-card:hover .home-product-card__media::after {
		opacity: 1;
	}

	.home-product-card__shine {
		position: absolute;
		inset: 0;
		z-index: 2;
		background: linear-gradient(115deg, transparent 40%, rgba(255,255,255,0.5) 50%, transparent 60%);
		background-size: 220% 100%;
		background-position: -200% 0;
		opacity: 0;
		pointer-events: none;
	}

	.home-product-card:hover .home-product-card__shine {
		opacity: 1;
		animation: shineSweep 1s ease forwards;
	}

	.home-product-card__view-btn {
		position: absolute;
		left: 50%;
		bottom: 16px;
		transform: translate(-50%, 14px);
		z-index: 3;
		background: rgba(255,255,255,0.95);
		color: var(--gal-charcoal);
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: .05em;
		padding: 9px 18px;
		border-radius: 30px;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 6px;
		opacity: 0;
		transition: opacity .3s ease, transform .3s cubic-bezier(.2,.8,.2,1);
		white-space: nowrap;
	}

	.home-product-card:hover .home-product-card__view-btn {
		opacity: 1;
		transform: translate(-50%, 0);
	}

	.home-product-card__badge {
		position: absolute;
		top: 12px;
		left: 12px;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		padding: 6px 13px;
		border-radius: 999px;
		color: #fff;
		text-transform: uppercase;
		z-index: 2;
		box-shadow: 0 3px 8px rgba(0,0,0,.18);
	}

		.home-product-card__badge.buy {
			background: var(--shop-dark-green);
			animation: badgeFloat 2.6s ease-in-out infinite;
		}

		.home-product-card__badge.bid {
			background: var(--auc-red);
			animation: badgePulseRed 2s ease-in-out infinite, badgeFloat 2.6s ease-in-out infinite;
		}

	@@keyframes badgeFloat {
		0%, 100% {
			transform: translateY(0);
		}

		50% {
			transform: translateY(-2px);
		}
	}

	@@keyframes badgePulseRed {
		0%, 100% {
			box-shadow: 0 0 0 0 rgba(194,59,59,.5), 0 3px 8px rgba(0,0,0,.18);
		}

		50% {
			box-shadow: 0 0 0 6px rgba(194,59,59,0), 0 3px 8px rgba(0,0,0,.18);
		}
	}

	.home-product-card__body {
		padding: 18px 20px 20px;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.home-product-card__title {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.05rem;
		color: var(--gal-charcoal);
		margin-bottom: 3px;
		transition: color .25s ease;
	}

	.home-product-card:hover .home-product-card__title {
		color: var(--shop-dark-green);
	}

	.auction-card:hover .home-product-card__title {
		color: var(--auc-red-dark);
	}

	.home-product-card__category {
		font-size: 0.75rem;
		font-weight: 600;
		margin-bottom: 10px;
	}

	.home-product-card__meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		margin-top: auto;
		margin-bottom: 14px;
	}

	.home-product-card__price {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.2rem;
	}

	.home-product-card__price-label {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: .04em;
		opacity: .75;
		display: block;
	}

	.home-btn-action {
		position: relative;
		overflow: hidden;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 6px;
		padding: 11px 16px;
		border-radius: 12px;
		font-weight: 600;
		font-size: 0.85rem;
		color: #fff;
		text-decoration: none;
		width: 100%;
		transition: transform 0.25s ease, box-shadow .25s ease;
	}

		.home-btn-action::before {
			content: "";
			position: absolute;
			top: 0;
			left: -60%;
			width: 40%;
			height: 100%;
			background: linear-gradient(120deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.4) 50%, rgba(255,255,255,0) 100%);
			transform: skewX(-20deg);
			transition: left .5s ease;
		}

		.home-btn-action:hover::before {
			left: 130%;
		}

		.home-btn-action:hover {
			transform: translateY(-3px);
			color: #fff;
		}

	/* ---- Buy Now identity ---- */
	.buynow-section-bg {
		background: linear-gradient(180deg, var(--gal-paper) 0%, var(--shop-ultra-light-green) 100%);
	}

	.home-product-card.buynow-card {
		border: 1px solid var(--shop-light-green);
	}

		.home-product-card.buynow-card:hover {
			box-shadow: 0 24px 44px -14px rgba(111,168,0,.32);
		}

	.home-product-card__category.buy-cat {
		color: var(--shop-dark-green);
	}

	.home-product-card__price.buy-price {
		color: var(--shop-dark-green);
	}

	.home-product-card__price-label.buy-price {
		color: var(--shop-dark-green);
	}

	.home-btn-action.buy {
		background: linear-gradient(135deg, var(--shop-dark-green), #587f00);
	}

		.home-btn-action.buy:hover {
			box-shadow: 0 12px 24px rgba(111,168,0,.35);
		}

	/* ---- Auction identity ---- */
	.auction-section-bg {
		background: linear-gradient(180deg, var(--gal-paper) 0%, var(--auc-cream) 100%);
		position: relative;
		overflow: hidden;
	}

		.auction-section-bg::before {
			content: "";
			position: absolute;
			top: -60px;
			right: -60px;
			width: 320px;
			height: 320px;
			background: radial-gradient(circle, rgba(217,140,0,.14), transparent 70%);
			pointer-events: none;
		}

		.auction-section-bg::after {
			content: "";
			position: absolute;
			bottom: -80px;
			left: -80px;
			width: 360px;
			height: 360px;
			background: radial-gradient(circle, rgba(194,59,59,.1), transparent 70%);
			pointer-events: none;
		}

	.home-product-card.auction-card {
		border: 1px solid var(--auc-cream-2);
	}

		.home-product-card.auction-card:hover {
			box-shadow: 0 24px 44px -14px rgba(194,59,59,.28);
		}

	.home-product-card__category.auc-cat {
		color: var(--auc-amber-dark);
	}

	.home-product-card__price.auc-price {
		color: var(--auc-red-dark);
	}

	.home-product-card__price-label.auc-price {
		color: var(--auc-amber-dark);
	}

	.home-btn-action.bid {
		background: linear-gradient(135deg, var(--auc-amber), var(--auc-red));
	}

		.home-btn-action.bid:hover {
			box-shadow: 0 12px 24px rgba(194,59,59,.35);
		}

	.auc-countdown {
		display: inline-flex;
		align-items: center;
		gap: 5px;
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--auc-red-dark);
		background: #fdeaea;
		border: 1px solid #f3c6c6;
		padding: 4px 10px;
		border-radius: 999px;
		margin-bottom: 10px;
		width: fit-content;
	}

		.auc-countdown.urgent {
			animation: pulseUrgentAuc 1.4s ease-in-out infinite;
		}

	@@keyframes pulseUrgentAuc {
		0%, 100% {
			box-shadow: 0 0 0 0 rgba(194,59,59,.35);
		}

		50% {
			box-shadow: 0 0 0 6px rgba(194,59,59,0);
		}
	}

	.no-items-msg {
		text-align: center;
		color: var(--gal-muted);
		font-family: var(--font-body);
		padding: 50px 20px;
		grid-column: 1 / -1;
	}

		.no-items-msg i {
			display: block;
			font-size: 2rem;
			margin-bottom: 10px;
			opacity: .5;
		}

	/* ---- Stats band ---- */
	.stats-area {
		background: var(--gal-ink);
		background-image: linear-gradient(180deg, var(--gal-ink) 0%, var(--gal-ink-2) 100%);
		padding: 70px 0;
	}

	.stat-item {
		text-align: center;
		padding: 10px 12px;
		border-left: 1px solid rgba(255,255,255,.12);
