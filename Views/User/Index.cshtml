<section class="subcat-area section-gap" id="collections">
	<div class="container">
		<div class="row d-flex justify-content-center">
			<div class="menu-content pb-40 col-lg-10">
				<div class="text-center section-heading-wrap reveal">
					<span class="gal-eyebrow">Browse by Collection</span>
					<h1 class="mb-10 gal-heading">Explore Every Collection</h1>
					<p class="gal-sub">From portraiture to abstract sculpture — find the category that speaks to you.</p>
					<div class="section-underline"></div>
				</div>
			</div>
		</div>
		<div class="row shop-cards-wrap">
			@{
				var subCategoryCounts = ViewBag.SubCategoryCounts as Dictionary<int, int>;
				var subCategoryImages = ViewBag.SubCategoryImages as Dictionary<int, string>;
			}
			@if (ViewBag.SubCategories != null && ((System.Collections.IEnumerable)ViewBag.SubCategories).GetEnumerator().MoveNext())
			{
				@foreach (var sc in ViewBag.SubCategories)
				{
					int scId = (int)sc.Id;
					int itemCount = (subCategoryCounts != null && subCategoryCounts.ContainsKey(scId)) ? subCategoryCounts[scId] : 0;
					string scImg = (subCategoryImages != null && subCategoryImages.ContainsKey(scId)) ? subCategoryImages[scId] : null;
					<div class="col-md-4 col-6 mb-4">
						<a href="/User/Allproducts?subCategoryId=@scId" class="shop reveal" style="display:block; text-decoration:none;">
							<div class="shop-media">
								@if (!string.IsNullOrEmpty(scImg))
								{
									<img src="@scImg" alt="@sc.Name">
								}
							</div>
							<div class="shop-panel"></div>
							<div class="shop-shine"></div>
							<span class="shop-count-badge"><i class="fa fa-cube"></i> @itemCount piece@(itemCount == 1 ? "" : "s")</span>
							<div class="shop-content">
								<h3>@sc.Name</h3>
								<span class="cta-btn">Shop Now <i class="fa fa-arrow-circle-right"></i></span>
							</div>
						</a>
					</div>
				}
			}
			else
			{
				<p class="subcat-empty text-center w-100">Collections will appear here once categories are added.</p>
			}
		</div>
	</div>
</section>
