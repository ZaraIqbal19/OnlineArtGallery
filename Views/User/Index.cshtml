	/* ============================================================
				   Motion — hero parallax + staggered scroll reveal
				   ============================================================ */
	.banner-area {
		background-position: center 50%;
	}

	.js-motion .reveal {
		opacity: 0;
		transform: translateY(28px);
		transition: opacity .7s ease, transform .7s ease;
	}

		.js-motion .reveal.is-visible {
			opacity: 1;
			transform: translateY(0);
		}

	.js-motion .shop-cards-wrap .col-md-4:nth-of-type(2) .reveal,
	.js-motion .shop-cards-wrap .col-6:nth-of-type(2) .reveal {
		transition-delay: .08s;
	}

	.js-motion .shop-cards-wrap .col-md-4:nth-of-type(3) .reveal,
	.js-motion .shop-cards-wrap .col-6:nth-of-type(3) .reveal {
		transition-delay: .16s;
	}

	.js-motion .shop-cards-wrap .col-md-4:nth-of-type(4) .reveal {
		transition-delay: .24s;
	}

	.js-motion .shop-cards-wrap .col-md-4:nth-of-type(5) .reveal {
		transition-delay: .32s;
	}

	.js-motion .shop-cards-wrap .col-md-4:nth-of-type(6) .reveal {
		transition-delay: .4s;
	}

	.js-motion .service-area .col-lg-4:nth-of-type(2) .reveal {
		transition-delay: .08s;
	}

	.js-motion .service-area .col-lg-4:nth-of-type(3) .reveal {
		transition-delay: .16s;
	}

	.js-motion .reviews-area .col-lg-4:nth-of-type(2) .reveal,
	.js-motion .reviews-area .col-md-6:nth-of-type(2) .reveal {
		transition-delay: .08s;
	}

	.js-motion .reviews-area .col-lg-4:nth-of-type(3) .reveal,
	.js-motion .reviews-area .col-md-6:nth-of-type(3) .reveal {
		transition-delay: .16s;
	}

	@@media (prefers-reduced-motion: reduce) {
		.js-motion .reveal, .home-product-card {
			opacity: 1 !important;
			transform: none !important;
			transition: none !important;
			animation: none !important;
		}

		.banner-area {
			background-attachment: initial !important;
		}

			.home-product-card__badge, .gal-eyebrow::before, .banner-area .banner-content h6::before {
				animation: none !important;
			}
	}
</style>

<script>
	document.addEventListener('DOMContentLoaded', function () {
		var prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

		document.documentElement.classList.add('js-motion');
		var revealEls = document.querySelectorAll('.reveal');
		if (prefersReduced || !('IntersectionObserver' in window)) {
			revealEls.forEach(function (el) { el.classList.add('is-visible'); });
		} else {
			var io = new IntersectionObserver(function (entries) {
				entries.forEach(function (entry) {
					if (entry.isIntersecting) {
						entry.target.classList.add('is-visible');
						io.unobserve(entry.target);
					}
				});
			}, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
			revealEls.forEach(function (el) { io.observe(el); });
		}

		// staggered per-card delay for product grids
		document.querySelectorAll('.pgrid .home-product-card').forEach(function (card, idx) {
			card.style.transitionDelay = (idx % 4) * 0.08 + 's';
		});

		// hero parallax
		if (!prefersReduced) {
			var banner = document.querySelector('.banner-area');
			if (banner) {
				var ticking = false;
				function updateParallax() {
					var rect = banner.getBoundingClientRect();
					var progress = Math.min(Math.max(-rect.top, 0), rect.height);
					var offset = progress * 0.25;
					banner.style.backgroundPosition = 'center calc(50% + ' + offset + 'px)';
					ticking = false;
				}
				window.addEventListener('scroll', function () {
					if (!ticking) { window.requestAnimationFrame(updateParallax); ticking = true; }
				}, { passive: true });
				updateParallax();
			}
		}

		// subtle 3D tilt on shop + product cards
		if (!prefersReduced && window.matchMedia('(pointer: fine)').matches) {
			document.querySelectorAll('.shop, .home-product-card').forEach(function (card) {
				card.addEventListener('mousemove', function (e) {
					var rect = card.getBoundingClientRect();
					var x = (e.clientX - rect.left) / rect.width - 0.5;
					var y = (e.clientY - rect.top) / rect.height - 0.5;
					card.style.transform = 'translateY(-8px) rotateX(' + (y * -4) + 'deg) rotateY(' + (x * 5) + 'deg)';
				});
				card.addEventListener('mouseleave', function () {
					card.style.transform = '';
				});
			});
		}

		// live auction countdowns
		var countdownEls = document.querySelectorAll('[data-auc-countdown]');
		function updateAucCountdowns() {
			countdownEls.forEach(function (el) {
				var end = new Date(el.getAttribute('data-auc-countdown')).getTime();
				var diff = end - Date.now();
				var textEl = el.querySelector('.auc-countdown-text');
				if (!textEl) return;
				if (diff <= 0) {
					textEl.textContent = 'Auction ended';
					el.classList.remove('urgent');
					return;
				}
				var d = Math.floor(diff / 86400000);
				var h = Math.floor((diff % 86400000) / 3600000);
				var m = Math.floor((diff % 3600000) / 60000);
				textEl.textContent = d > 0 ? (d + 'd ' + h + 'h left') : (h > 0 ? (h + 'h ' + m + 'm left') : (m + 'm left'));
				el.classList.toggle('urgent', diff <= 86400000);
			});
		}
		if (countdownEls.length) { updateAucCountdowns(); setInterval(updateAucCountdowns, 30000); }
	});
</script>


