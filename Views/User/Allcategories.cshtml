@model IEnumerable<Art_Gallery.Models.Category>

@{
    ViewData["Title"] = "Categories";
    Layout = "~/Views/Shared/_UserLayout.cshtml";

    // Retrieve the subcategories from ViewBag and cast them so we can use LINQ
    var subCategories = ViewBag.SubCategories as List<Art_Gallery.Models.SubCategory>;
    var maxSubCount = Model?.Max(c => subCategories?.Count(s => s.CategoryId == c.Id) ?? 0) ?? 0;

}

<style>
    /* Color Theme Variables */
    :root {
        --primary-red: #88d200;
        --dark-red: #6fa800;
        --light-red: #d4f09b;
        --ultra-light-red: #f0fae6;
    }

    /* Section Styling */
    .artify-categories-section {
        padding: 70px 0;
        background: linear-gradient(180deg, #fbfffa 0%, #f6fff5 100%);
    }

    .section-title {
        text-align: center;
        margin-bottom: 55px;
    }

    .artify-eyebrow {
        display: inline-block;
        background: var(--ultra-light-red);
        color: var(--dark-red);
        padding: 6px 20px;
        border-radius: 50px;
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 1px;
        margin-bottom: 14px;
        border: 1px solid var(--light-red);
    }

        .artify-eyebrow i {
            margin-right: 8px;
            color: var(--primary-red);
        }

    .section-title .title {
        font-weight: 800;
        font-size: 40px;
        color: #232323;
        margin-bottom: 12px;
        letter-spacing: -0.5px;
    }

        .section-title .title span {
            color: var(--primary-red);
        }

    .section-title .subtitle {
        color: #7a7a7a;
        font-size: 17px;
        font-weight: 400;
        max-width: 480px;
        margin: 0 auto;
    }

    /* Shop Card - diagonal green panel always visible, text always visible */
    .shop {
        position: relative;
        overflow: hidden;
        margin: 15px 0px;
        border-radius: 20px;
        height: 230px;
        cursor: pointer;
        box-shadow: 0 8px 24px rgba(0, 20, 4, 0.1);
        opacity: 0;
        animation: shopFadeIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
        transition: transform 0.35s ease, box-shadow 0.35s ease;
    }

    @@keyframes shopFadeIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .shop:hover {
        transform: translateY(-6px);
        box-shadow: 0 18px 40px rgba(0, 20, 4, 0.18);
    }

    /* Full-bleed background image */
    .shop-media {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: var(--ultra-light-red);
        overflow: hidden;
    }

        .shop-media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        }

    .shop:hover .shop-media img {
        transform: scale(1.08);
    }

    /* Diagonal green panel - always on, not hover-triggered */
    .shop-panel {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: linear-gradient(135deg, var(--primary-red) 0%, var(--dark-red) 55%, #3d6600 100%);
        clip-path: polygon(0 0, 62% 0, 46% 100%, 0 100%);
        pointer-events: none;
    }

    /* Text + CTA, always visible, sitting on the green panel */
    .shop-content {
        position: absolute;
        inset: 0;
        z-index: 3;
        display: flex;
        flex-direction: column;
        justify-content: center;
        max-width: 58%;
        padding: 24px 16px 24px 26px;
        pointer-events: none;
    }

        .shop-content h3 {
            color: #fff;
            font-weight: 800;
            font-size: 21px;
            line-height: 1.28;
            margin: 0 0 18px;
            text-shadow: 0 2px 10px rgba(0,0,0,0.15);
        }

        .shop-content .cta-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            color: #fff;
            text-transform: uppercase;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 0.5px;
            white-space: nowrap;
            border: 1.5px solid rgba(255,255,255,0.7);
            border-radius: 30px;
            padding: 9px 18px;
            width: fit-content;
            max-width: none;
            text-decoration: none;
            transition: background 0.25s ease, transform 0.2s ease;
            pointer-events: auto;
        }

            .shop-content .cta-btn:hover {
                background: rgba(255,255,255,0.18);
                transform: translateY(-2px);
                color: #fff;
                text-decoration: none;
            }

            .shop-content .cta-btn i {
                font-size: 13px;
            }

    /* Badges */
    .shop-icon-badge {
        position: absolute;
        top: 14px;
        left: 14px;
        z-index: 4;
        width: 32px;
        height: 32px;
        border-radius: 10px;
        background: var(--dark-red);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    }

    .shop-count-badge {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 4;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255,255,255,0.95);
        color: var(--dark-red);
        font-size: 11px;
        font-weight: 700;
        padding: 5px 13px;
        border-radius: 20px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.12);
    }

        .shop-count-badge i {
            font-size: 9px;
        }

    .shop-popular-badge {
        position: absolute;
        bottom: 14px;
        right: 14px;
        z-index: 4;
        background: linear-gradient(135deg, #a8e063, #6fa800);
        color: #fff;
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
        box-shadow: 0 4px 12px rgba(111, 168, 0, 0.35);
    }

        .shop-popular-badge i {
            margin-right: 5px;
        }

    /* Empty state */
    .categories-empty-state {
        text-align: center;
        padding: 60px 20px;
        color: #999;
    }

        .categories-empty-state i {
            font-size: 48px;
            color: var(--light-red);
            margin-bottom: 16px;
            display: block;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .section-title .title {
            font-size: 28px;
        }

        .shop {
            height: 200px;
        }

        .shop-content {
            max-width: 64%;
            padding: 18px 14px 18px 20px;
        }

            .shop-content h3 {
                font-size: 17px;
                margin-bottom: 14px;
            }

            .shop-content .cta-btn {
                font-size: 11px;
                padding: 7px 14px;
            }

        .shop-panel {
            clip-path: polygon(0 0, 68% 0, 50% 100%, 0 100%);
        }
    }

    @@media (max-width: 576px) {
        .shop {
            height: 180px;
        }

        .shop-content h3 {
            font-size: 15px;
        }

        .shop-panel {
            clip-path: polygon(0 0, 78% 0, 55% 100%, 0 100%);
        }

        .shop-content {
            max-width: 74%;
        }
    }
</style>

<div class="section artify-categories-section">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="section-title">
                    <span class="artify-eyebrow"><i class="fa fa-th-large"></i> Explore</span>
                    <h3 class="title">Browse <span>Categories</span></h3>
                    <p class="subtitle">Find exactly what you need, sorted by category.</p>
                </div>
            </div>

            @{
                int index = 0;
            }

            @if (Model == null || !Model.Any())
            {
                <div class="col-12">
                    <div class="categories-empty-state">
                        <i class="fa fa-folder-open"></i>
                        <p>No categories have been added yet.</p>
                    </div>
                </div>
            }
            else
            {
                @foreach (var category in Model)
                {
                    var subCount = subCategories?.Count(s => s.CategoryId == category.Id) ?? 0;
                    var isMostPopular = maxSubCount > 0 && subCount == maxSubCount;
                    var imageUrl = category.Categoryimage;
                    var delay = (index % 6) * 0.08;
                    index++;

                    <div class="col-md-4 col-6 mb-4">
                        <div class="shop" style="animation-delay:@delay.ToString("0.00")s">
                            <div class="shop-media">
                                <img src="@imageUrl" alt="@category.Name" loading="lazy" />
                            </div>
                            <div class="shop-panel"></div>

                            <span class="shop-icon-badge"><i class="fa fa-tag"></i></span>
                            <span class="shop-count-badge"><i class="fa fa-cube"></i> @subCount items</span>

                            <div class="shop-content">
                                <h3>@category.Name<br>Collection</h3>
                                <a href="@Url.Action("Allproducts", "user", new { categoryId = category.Id })" class="cta-btn">
                                    Shop Now <i class="fa fa-arrow-circle-right"></i>
                                </a>
                            </div>

                            @if (isMostPopular)
                            {
                                <span class="shop-popular-badge"><i class="fa fa-fire"></i> Most Popular</span>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
