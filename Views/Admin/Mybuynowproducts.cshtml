        padding: 0.7rem 2rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1);
        cursor: pointer;
        flex: 1;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
    }

        .buynow-page .delete-modal .btn-confirm-delete:hover {
            transform: scale(1.02) translateY(-2px);
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
            background: linear-gradient(135deg, #c82333, #a71d2a);
        }

    /* ===== SUCCESS TOAST ===== */
    .buynow-page .toast-container-custom {
        position: fixed;
        top: 30px;
        right: 30px;
        z-index: 9999;
        min-width: 320px;
        max-width: 450px;
        pointer-events: none;
    }

    .buynow-page .toast-success {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(10px);
        border-left: 8px solid #88d200;
        border-radius: 20px;
        box-shadow: 0 20px 60px -12px rgba(0, 0, 0, 0.25), 0 4px 20px rgba(136, 210, 0, 0.12);
        padding: 20px 28px;
        color: #1a1a2e;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 16px;
        opacity: 1;
        pointer-events: none;
        animation: slideInRightBuynow 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes slideInRightBuynow {
        from {
            transform: translateX(120%) scale(0.9);
            opacity: 0;
        }

        to {
            transform: translateX(0) scale(1);
            opacity: 1;
        }
    }

    .buynow-page .toast-success i {
        font-size: 2rem;
        color: #88d200;
        background: linear-gradient(135deg, #f0fae6, #d4f09b);
        padding: 12px;
        border-radius: 50%;
        box-shadow: 0 2px 10px rgba(136, 210, 0, 0.15);
        animation: checkBounceBuynow 0.6s ease;
    }

    @@keyframes checkBounceBuynow {
        0% {
            transform: scale(0);
        }

        50% {
            transform: scale(1.2);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            transform: scale(1);
        }
    }

    .buynow-page .toast-success .toast-content {
        flex: 1;
    }

    .buynow-page .toast-success .toast-title {
        font-weight: 700;
        color: #1a1a2e;
        font-size: 1rem;
    }

    .buynow-page .toast-success .toast-message {
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 2px;
    }

    .buynow-page .toast-success.hide {
        animation: slideOutRightBuynow 0.5s cubic-bezier(0.2, 0.9, 0.4, 1) forwards;
    }

    @@keyframes slideOutRightBuynow {
        from {
            transform: translateX(0) scale(1);
            opacity: 1;
        }

        to {
            transform: translateX(120%) scale(0.9);
            opacity: 0;
        }
    }

    .buynow-page .fade-out {
        animation: fadeOutBuynow 0.5s cubic-bezier(0.2, 0.9, 0.4, 1) forwards;
    }

    @@keyframes fadeOutBuynow {
        0% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }

        100% {
            opacity: 0;
            transform: scale(0.8) translateY(-20px);
        }
    }

    /* responsive */
    @@media (max-width: 768px) {
        .buynow-page .admin-card {
            padding: 1.2rem;
        }

        .buynow-page .heading-green {
            font-size: 1.45rem;
        }

        .buynow-page .brand-icon {
            width: 40px;
            height: 40px;
            font-size: 1.25rem;
        }

        .buynow-page .table-green-white thead th,
        .buynow-page .table-green-white tbody td {
            padding: 10px 10px;
            font-size: 0.84rem;
        }

        .buynow-page .btn-action {
            padding: 6px 12px;
            font-size: 0.7rem;
        }

        .buynow-page .actions-wrap {
            gap: 4px;
        }

        .buynow-page .table-green-white tbody td:first-child {
            padding-left: 14px;
        }

        .buynow-page .table-green-white tbody td:last-child {
            padding-right: 14px;
        }

        .buynow-page .stats-row {
            grid-template-columns: repeat(2, 1fr);
        }

        .buynow-page .toolbar-row {
            flex-direction: column;
            align-items: stretch;
        }

        .buynow-page .search-box {
            max-width: unset;
        }

        .buynow-page .toolbar-right {
            justify-content: space-between;
        }

        .buynow-page .header-actions {
            width: 100%;
            justify-content: space-between;
        }

        .buynow-page .toast-container-custom {
            top: 20px;
            right: 20px;
            left: 20px;
            min-width: unset;
            max-width: unset;
        }

        .buynow-page .delete-modal {
            padding: 2rem 1.5rem;
        }

            .buynow-page .delete-modal .modal-actions {
                flex-direction: column;
            }
    }

    @@media (max-width: 576px) {
        .buynow-page .header-section {
            flex-direction: column;
            align-items: start;
            gap: 0.8rem;
        }

        .buynow-page .header-actions {
            width: 100%;
            justify-content: flex-start;
            flex-wrap: wrap;
        }

        .buynow-page .stats-row {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="buynow-page">
    <div class="container-cust">
        <div class="admin-card">

            <!-- header -->
            <div class="header-section">
                <div class="brand-head">
                    <div class="brand-icon">
                        <i class="fas fa-cart-shopping"></i>
                    </div>
                    <h1 class="heading-green">
                        My Buy Now Products
                        <span>@Model.Count()</span>
                    </h1>
                </div>
                <div class="header-actions">
                    <div class="status-badge">
                        <i class="fas fa-circle" style="font-size: 0.5rem;"></i> my listings
                    </div>
                    <button type="button" class="btn-header-action" id="refreshBuynowBtn" onclick="refreshBuynow(this)">
                        <i class="fas fa-rotate"></i> Refresh
                    </button>
                    <button type="button" class="btn-export" onclick="exportBuynowCsv()">
                        <i class="fas fa-file-export"></i> Export CSV
                    </button>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert-success-cust">
                    <i class="fas fa-check-circle"></i> @TempData["Message"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert-info-cust">
                    <i class="fas fa-cart-shopping"></i>
                    You don't have any buy-now products listed yet.
                </div>
            }
            else
            {
                <!-- stat cards -->
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-box"></i></div>
                        <div>
                            <div class="stat-value">@Model.Count()</div>
                            <div class="stat-label">Product Listings</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-cubes"></i></div>
                        <div>
                            <div class="stat-value">@Model.Sum(p => p.quantity)</div>
                            <div class="stat-label">Total Quantity</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-rupee-sign"></i></div>
                        <div>
                            <div class="stat-value">Rs. @Model.Sum(p => p.price)</div>
                            <div class="stat-label">Total Listed Value</div>
                        </div>
                    </div>
                </div>

                <!-- search / toolbar -->
                <div class="toolbar-row">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="productSearch" placeholder="Search by name, subcategory or status..." onkeyup="filterProducts()" />
                    </div>
                    <div class="toolbar-right">
                        <span class="result-count" id="resultCount">@Model.Count() of @Model.Count() shown</span>
                        <span class="scroll-hint">
                            <i class="fas fa-arrows-left-right"></i> click &amp; drag to scroll
                        </span>
                    </div>
                </div>

                <!-- table -->
                <div class="table-responsive-cust" id="productTableScroll">
                    <table class="table table-green-white">
                        <thead>
                            <tr>
                                <th><span class="th-inner"><i class="fas fa-image fa-fw-lead"></i> Image</span></th>
                                <th class="sortable" onclick="sortTable(1, this)"><span class="th-inner"><i class="fas fa-box-open fa-fw-lead"></i> Product <i class="fas fa-sort sort-icon"></i></span></th>
                                <th><span class="th-inner"><i class="fas fa-align-left fa-fw-lead"></i> Description</span></th>
                                <th><span class="th-inner"><i class="fas fa-tags fa-fw-lead"></i> Subcategory</span></th>
                                <th class="sortable" onclick="sortTable(4, this)"><span class="th-inner"><i class="fas fa-rupee-sign fa-fw-lead"></i> Price <i class="fas fa-sort sort-icon"></i></span></th>
                                <th class="sortable" onclick="sortTable(5, this)"><span class="th-inner"><i class="fas fa-hashtag fa-fw-lead"></i> Quantity <i class="fas fa-sort sort-icon"></i></span></th>
                                <th><span class="th-inner"><i class="fas fa-info-circle fa-fw-lead"></i> Status</span></th>
                                <th class="text-end"><span class="th-inner"><i class="fas fa-bolt fa-fw-lead"></i> Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowIndex = 0;
                            }
                            @foreach (var item in Model)
                            {
                                rowIndex++;
                                var statusClass = (item.Status ?? "").ToLower().Replace(" ", "-");
                                <tr style="--i: @rowIndex;" data-product-id="@item.Id">
                                    <td>
                                        @{
                                            var imgFile = GetProductImageFileName(item.Image1);
                                        }
                                        @if (!string.IsNullOrEmpty(imgFile))
                                        {
                                            <img src="~/images/products/@imgFile"
                                                 class="product-thumb"
                                                 onerror="this.onerror=null;this.replaceWith(Object.assign(document.createElement('div'),{className:'thumb-fallback',innerHTML:'<i class=\'fas fa-image\'></i>'}));" />
                                        }
                                        else
                                        {
                                            <div class="thumb-fallback"><i class="fas fa-image"></i></div>
                                        }
                                    </td>
                                    <td><span class="product-name-cell">@item.Name</span></td>
                                    <td><span class="desc-cell">@item.Description</span></td>
                                    <td><span class="info-pill">@item.SubCategory?.Name</span></td>
                                    <td><span class="price-cell">Rs. @item.price</span></td>
                                    <td><span class="info-pill">@item.quantity</span></td>
                                    <td>
                                        <span class="status-badge-row status-@statusClass">
                                            <i class="fas fa-circle" style="font-size: 0.45rem;"></i> @item.Status
                                        </span>
                                    </td>
                                    <td style="text-align: right;">
                                        <div class="actions-wrap" style="justify-content: flex-end;">
                                            <a asp-controller="Admin" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-action btn-edit">
                                                <i class="fas fa-pen"></i> Edit
                                            </a>
                                            <a asp-controller="Admin" asp-action="Details" asp-route-id="@item.Id" class="btn btn-action btn-details">
                                                <i class="fas fa-eye"></i> Details
                                            </a>
                                            <button type="button" class="btn btn-action btn-delete"
                                                    onclick="openDeleteModal('@item.Id', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(item.Name))')">
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr class="empty-state-row" id="noResultsRow" style="display: none;">
                                <td colspan="8">
                                    <i class="fas fa-inbox"></i>
                                    No matching products found.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- footer -->
                <div class="table-footer">
                    <span>
                        <i class="fas fa-arrow-right"></i> hover rows · click headers to sort · green theme
                    </span>
                    <span class="pill">
                        <i class="fas fa-cart-shopping"></i> @Model.Count() buy-now listings
                    </span>
                </div>
            }

        </div> <!-- end admin-card -->
        <!-- ===== DELETE CONFIRMATION MODAL ===== -->
        <div id="deleteModal" class="delete-modal-overlay">
            <div class="delete-modal">
                <div class="modal-icon">
                    <i class="fas fa-exclamation-triangle"></i>
                </div>
                <h3>Delete Product Listing?</h3>
                <p>
                    Are you sure you want to delete
                    <span class="contact-highlight" id="modalProductName">"..."</span>?
                    <br>
                    <small style="color: #dc3545; font-weight: 500;">
                        <i class="fas fa-exclamation-circle"></i> This action cannot be undone.
                    </small>
                </p>
                <div class="modal-actions">
                    <button class="btn-cancel" onclick="closeDeleteModal()">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button class="btn-confirm-delete" id="confirmDeleteBtn">
                        <i class="fas fa-trash-alt"></i> Yes, Delete
                    </button>
                </div>
            </div>
        </div>

        <!-- ===== SUCCESS TOAST ===== -->
        <div id="successToast" class="toast-container-custom">
            <div id="toastMessage" class="toast-success" style="display: none;">
                <i class="fas fa-check-circle"></i>
                <div class="toast-content">
                    <div class="toast-title">Deleting...</div>
                    <div class="toast-message" id="toastText">Removing product listing</div>
                </div>
            </div>
        </div>

    </div> <!-- end container-cust -->
</div> <!-- end buynow-page -->

<script>

    let deleteProductId = null;

    function filterProducts() {
        const query = document.getElementById('productSearch').value.trim().toLowerCase();
        const rows = document.querySelectorAll('.buynow-page .table-green-white tbody tr:not(#noResultsRow)');
        let visibleCount = 0;

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const matches = text.includes(query);
            row.style.display = matches ? '' : 'none';
            if (matches) visibleCount++;
        });

        document.getElementById('noResultsRow').style.display = visibleCount === 0 ? '' : 'none';

        const totalRows = rows.length;
        const countEl = document.getElementById('resultCount');
        if (countEl) countEl.textContent = `${visibleCount} of ${totalRows} shown`;
    }

    // Click-to-sort table columns
    let sortDirections = {};
    function sortTable(colIndex, headerEl) {
        const table = headerEl.closest('table');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr:not(#noResultsRow)'));

        const asc = !sortDirections[colIndex];
        sortDirections = {};
        sortDirections[colIndex] = asc;

        table.querySelectorAll('thead th').forEach(th => th.classList.remove('sort-asc', 'sort-desc'));
        headerEl.classList.add(asc ? 'sort-asc' : 'sort-desc');

        rows.sort((a, b) => {
            const cellA = a.children[colIndex].textContent.replace(/[^0-9.\-a-zA-Z]/g, '').trim().toLowerCase();
            const cellB = b.children[colIndex].textContent.replace(/[^0-9.\-a-zA-Z]/g, '').trim().toLowerCase();
            const numA = parseFloat(cellA), numB = parseFloat(cellB);
            const bothNumeric = !isNaN(numA) && !isNaN(numB);
            const cmp = bothNumeric ? (numA - numB) : cellA.localeCompare(cellB);
            return asc ? cmp : -cmp;
        });

        rows.forEach(row => tbody.insertBefore(row, document.getElementById('noResultsRow')));
    }

    // Spin the refresh icon briefly, then reload the page
    function refreshBuynow(btn) {
        btn.classList.add('spinning');
        setTimeout(() => {
            window.location.reload();
        }, 400);
    }

    // Export the currently visible (search-filtered) rows to a CSV file
    function exportBuynowCsv() {
        const rows = document.querySelectorAll('.buynow-page .table-green-white tbody tr:not(#noResultsRow)');
        const headers = ['Product', 'Description', 'Subcategory', 'Price', 'Quantity', 'Status'];
        const csvRows = [headers.join(',')];

        rows.forEach(row => {
            if (row.style.display === 'none') return; // respect current search filter
            const product = row.querySelector('.product-name-cell')?.textContent.trim() ?? '';
            const desc = row.querySelector('.desc-cell')?.textContent.trim() ?? '';
            const status = row.querySelector('.status-badge-row')?.textContent.trim() ?? '';
            const cells = Array.from(row.children);
            const subcategory = cells[3]?.textContent.trim() ?? '';
            const price = cells[4]?.textContent.trim() ?? '';
            const quantity = cells[5]?.textContent.trim() ?? '';

            const values = [product, desc, subcategory, price, quantity, status];
            const escaped = values.map(v => `"${v.replace(/"/g, '""')}"`);
            csvRows.push(escaped.join(','));
        });

        const blob = new Blob([csvRows.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = `my_buynow_products_${new Date().toISOString().slice(0, 10)}.csv`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(link.href);
    }

    // ===== Delete confirmation modal =====
    function openDeleteModal(productId, productName) {
        deleteProductId = productId;
        document.getElementById('modalProductName').textContent = `"${productName}"`;

        const modal = document.getElementById('deleteModal');
        modal.style.display = 'flex';

        const modalContent = modal.querySelector('.delete-modal');
        modalContent.style.animation = 'none';
        setTimeout(() => {
            modalContent.style.animation = 'modalSlideUpBuynow 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        }, 10);
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
        deleteProductId = null;
    }

    // Confirms in-page, shows a success toast, then navigates to the
    // Mybuynowproductsdeletelogic action on the Admin controller.
    document.getElementById('confirmDeleteBtn').addEventListener('click', function () {
        if (deleteProductId) {
            const idToDelete = deleteProductId; // capture before closeDeleteModal() clears it
            const row = document.querySelector(`tr[data-product-id="${idToDelete}"]`);
            closeDeleteModal();
            showSuccessToast('Deleted!', 'The product listing was removed successfully.');

            if (row) {
                row.classList.add('fade-out');
            }

            setTimeout(() => {
                window.location.href = '@Url.Action("Mybuynowproductsdeletelogic", "Admin")/' + idToDelete;
            }, 900);
        }
    });

    document.getElementById('deleteModal').addEventListener('click', function (e) {
        if (e.target === this) closeDeleteModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDeleteModal();
    });

    function showSuccessToast(title, message) {
        const toast = document.getElementById('toastMessage');
        const textSpan = document.getElementById('toastText');
        const titleEl = toast.querySelector('.toast-title');

        if (titleEl) titleEl.innerText = title;
        if (textSpan) textSpan.innerText = message;

        toast.classList.remove('hide');
        toast.style.display = 'flex';

        toast.style.animation = 'none';
        setTimeout(() => {
            toast.style.animation = 'slideInRightBuynow 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        }, 10);

        clearTimeout(window.toastTimeout);
        window.toastTimeout = setTimeout(() => {
            toast.classList.add('hide');
            setTimeout(() => { toast.style.display = 'none'; }, 500);
        }, 4000);
    }

    // ===== Click & drag horizontal scrolling for the table =====
    (function () {
        const scroller = document.getElementById('productTableScroll');
        if (!scroller) return;

        let isDown = false;
        let startX;
        let scrollLeftStart;

        scroller.addEventListener('mousedown', (e) => {
            isDown = true;
            scroller.classList.add('dragging');
            startX = e.pageX - scroller.offsetLeft;
            scrollLeftStart = scroller.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
            isDown = false;
            scroller.classList.remove('dragging');
        });

        scroller.addEventListener('mouseleave', () => {
            isDown = false;
            scroller.classList.remove('dragging');
        });

        scroller.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - scroller.offsetLeft;
            const walk = (x - startX);
            scroller.scrollLeft = scrollLeftStart - walk;
        });

        // touch support
        let touchStartX = 0;
        let touchScrollStart = 0;
        scroller.addEventListener('touchstart', (e) => {
            touchStartX = e.touches[0].pageX;
            touchScrollStart = scroller.scrollLeft;
        }, { passive: true });

        scroller.addEventListener('touchmove', (e) => {
            const dx = e.touches[0].pageX - touchStartX;
            scroller.scrollLeft = touchScrollStart - dx;
        }, { passive: true });
    })();
</script>