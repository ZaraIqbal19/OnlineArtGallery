@model IEnumerable<Art_Gallery.Models.ProductReview>
@{
    ViewData["Title"] = "All Product Reviews";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />

<style>
    /* ===== everything scoped under .review-page so it can't leak into the admin shell ===== */
    .review-page {
        font-family: 'Inter', 'Segoe UI', Roboto, system-ui, sans-serif;
        padding: 1.5rem 0;
    }

        .review-page *,
        .review-page *::before,
        .review-page *::after {
            box-sizing: border-box;
        }

        .review-page .container-cust {
            max-width: 1180px;
            margin: 0 auto;
        }

        .review-page .admin-card {
            background: rgba(255, 255, 255, 0.97);
            border-radius: 2rem;
            padding: 2rem 1.8rem 1.8rem 1.8rem;
            box-shadow: 0 20px 45px -16px rgba(111, 168, 0, 0.22), 0 4px 18px rgba(136, 210, 0, 0.06);
            border: 1px solid rgba(136, 210, 0, 0.12);
            position: relative;
            overflow: hidden;
        }

            .review-page .admin-card::before {
                content: "";
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 6px;
                background: linear-gradient(90deg, #d4f09b, #88d200, #6fa800);
            }

        /* header */
        .review-page .header-section {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            margin-bottom: 1.8rem;
            padding-bottom: 0.75rem;
            border-bottom: 2px solid rgba(136, 210, 0, 0.18);
        }

        .review-page .brand-head {
            display: flex;
            align-items: center;
            gap: 0.9rem;
        }

        .review-page .brand-icon {
            background: #88d200;
            width: 48px;
            height: 48px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 1.5rem;
            box-shadow: 0 8px 18px rgba(136, 210, 0, 0.35);
            transition: all 0.25s;
            flex-shrink: 0;
        }

            .review-page .brand-icon:hover {
                transform: rotate(-6deg) scale(1.04);
                background: #6fa800;
            }

        .review-page .heading-green {
            font-weight: 700;
            font-size: 1.85rem;
            letter-spacing: -0.5px;
            color: #1a1a1a;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

            .review-page .heading-green span {
                background: #88d200;
                color: white;
                font-size: 0.85rem;
                font-weight: 600;
                padding: 0.2rem 1rem;
                border-radius: 60px;
                letter-spacing: 0.3px;
            }

        .review-page .status-badge {
            background: white;
            border: 1.5px solid #88d200;
            color: #6fa800;
            border-radius: 60px;
            padding: 0.4rem 1.2rem;
            font-weight: 600;
            font-size: 0.78rem;
            letter-spacing: 0.4px;
            white-space: nowrap;
        }

            .review-page .status-badge i {
                color: #88d200;
                margin-right: 6px;
            }

        /* success alert from TempData */
        .review-page .alert-success-cust {
            background: #f0fae6;
            border: 1.5px solid #88d200;
            color: #4c7800;
            border-radius: 16px;
            padding: 14px 22px;
            font-weight: 600;
            margin-bottom: 1.4rem;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .review-page .alert-success-cust i {
                color: #88d200;
                font-size: 1.1rem;
            }

        .review-page .alert-info-cust {
            background: #f0fae6;
            border: 1.5px dashed #d4f09b;
            color: #5c7a2e;
            border-radius: 16px;
            padding: 30px 22px;
            font-weight: 600;
            text-align: center;
        }

            .review-page .alert-info-cust i {
                display: block;
                font-size: 2rem;
                color: #d4f09b;
                margin-bottom: 10px;
            }

        /* stat cards */
        .review-page .stats-row {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 14px;
            margin-bottom: 1.4rem;
        }

        .review-page .stat-card {
            background: #f0fae6;
            border: 1px solid #d4f09b;
            border-radius: 16px;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.25s;
        }

            .review-page .stat-card:hover {
                background: #d4f09b;
                transform: translateY(-3px);
                box-shadow: 0 10px 22px rgba(136, 210, 0, 0.22);
            }

        .review-page .stat-icon {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: #88d200;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.05rem;
            flex-shrink: 0;
            box-shadow: 0 6px 14px rgba(136, 210, 0, 0.3);
        }

        .review-page .stat-value {
            font-weight: 700;
            font-size: 1.25rem;
            color: #1a1a1a;
            line-height: 1.1;
        }

        .review-page .stat-label {
            font-size: 0.76rem;
            color: #5c7a2e;
            font-weight: 600;
            margin-top: 2px;
        }

        /* toolbar / search */
        .review-page .toolbar-row {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 1.1rem;
        }

        .review-page .search-box {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f0fae6;
            border: 1.5px solid #d4f09b;
            border-radius: 60px;
            padding: 9px 20px;
            flex: 1;
            max-width: 340px;
            transition: all 0.2s;
        }

            .review-page .search-box:focus-within {
                border-color: #88d200;
                background: white;
                box-shadow: 0 6px 16px rgba(136, 210, 0, 0.18);
            }

            .review-page .search-box i {
                color: #6fa800;
            }

            .review-page .search-box input {
                border: none;
                outline: none;
                background: transparent;
                font-size: 0.88rem;
                width: 100%;
                color: #1a1a1a;
            }

        .review-page .toolbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .review-page .result-count {
            font-size: 0.8rem;
            color: #5c7a2e;
            font-weight: 600;
            white-space: nowrap;
        }

        .review-page .scroll-hint {
            font-size: 0.78rem;
            color: #6fa800;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        /* rating filter chips */
        .review-page .rating-filter {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .review-page .rating-chip {
            border: 1.5px solid #d4f09b;
            background: white;
            color: #5c7a2e;
            border-radius: 60px;
            padding: 6px 14px;
            font-size: 0.76rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            white-space: nowrap;
        }

            .review-page .rating-chip:hover {
                border-color: #88d200;
                color: #6fa800;
            }

            .review-page .rating-chip.active {
                background: #88d200;
                border-color: #88d200;
                color: white;
            }

        /* table (drag-to-scroll, hidden scrollbar) */
        .review-page .table-responsive-cust {
            border-radius: 1.6rem;
            overflow-x: auto;
            overflow-y: hidden;
            padding-bottom: 6px;
            scrollbar-width: none;
            cursor: grab;
            user-select: none;
        }

            .review-page .table-responsive-cust::-webkit-scrollbar {
                display: none;
            }

            .review-page .table-responsive-cust.dragging {
                cursor: grabbing;
            }

        .review-page .table-green-white {
            border-collapse: separate;
            border-spacing: 0 10px;
            width: 100%;
            min-width: 880px;
            margin-bottom: 0;
        }

            .review-page .table-green-white thead th {
                background: #88d200;
                color: white;
                font-weight: 600;
                font-size: 0.76rem;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                padding: 15px 18px;
                border: none;
                text-align: left;
                vertical-align: middle;
                white-space: nowrap;
            }

                .review-page .table-green-white thead th .th-inner {
                    display: inline-flex;
                    align-items: center;
                    gap: 6px;
                }

                .review-page .table-green-white thead th.text-end .th-inner {
                    justify-content: flex-end;
                }

                .review-page .table-green-white thead th:first-child {
                    border-radius: 20px 0 0 20px;
                    padding-left: 26px;
                }

                .review-page .table-green-white thead th:last-child {
                    border-radius: 0 20px 20px 0;
                    padding-right: 26px;
                }

                .review-page .table-green-white thead th.text-end {
                    text-align: right;
                }

                .review-page .table-green-white thead th.sortable {
                    cursor: pointer;
                    user-select: none;
                }

                    .review-page .table-green-white thead th.sortable .sort-icon {
                        margin-left: 6px;
                        font-size: 0.63rem;
                        opacity: 0.6;
                        transition: opacity 0.2s, transform 0.2s;
                    }

                    .review-page .table-green-white thead th.sortable:hover .sort-icon {
                        opacity: 1;
                    }

                .review-page .table-green-white thead th.sort-asc .sort-icon,
                .review-page .table-green-white thead th.sort-desc .sort-icon {
                    opacity: 1;
                }

                .review-page .table-green-white thead th.sort-desc .sort-icon {
                    transform: rotate(180deg);
                }

        .review-page .empty-state-row td {
            text-align: center;
            padding: 40px 20px !important;
            color: #8a9a6e;
            font-weight: 500;
            font-size: 0.95rem;
            border-radius: 20px !important;
        }

        .review-page .empty-state-row i {
            display: block;
            font-size: 2rem;
            color: #d4f09b;
            margin-bottom: 10px;
        }

        .review-page .table-green-white tbody tr {
            background: white;
            border-radius: 18px;
            box-shadow: 0 4px 14px rgba(111, 168, 0, 0.05);
            transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
            border: 1px solid rgba(136, 210, 0, 0.06);
            opacity: 0;
            animation: fadeSlideRv 0.45s forwards;
            animation-delay: calc(0.05s * var(--i, 1));
        }

    @@keyframes fadeSlideRv {
        0% {
            opacity: 0;
            transform: translateY(16px) scale(0.98);
        }

        100% {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .review-page .table-green-white tbody tr:hover {
        background: #fbffef;
        border-color: #d4f09b;
        transform: scale(1.006) translateY(-2px);
        box-shadow: 0 14px 28px rgba(111, 168, 0, 0.12);
    }

    .review-page .table-green-white tbody td {
        padding: 12px 18px;
        vertical-align: middle;
        border: none;
        background: transparent;
        font-size: 0.92rem;
    }

        .review-page .table-green-white tbody td:first-child {
            padding-left: 26px;
            border-radius: 18px 0 0 18px;
        }

        .review-page .table-green-white tbody td:last-child {
            padding-right: 26px;
            border-radius: 0 18px 18px 0;
        }

    /* product cell w/ image */
    .review-page .product-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .review-page .product-thumb {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        object-fit: cover;
        flex-shrink: 0;
        border: 1px solid rgba(136, 210, 0, 0.18);
        box-shadow: 0 4px 10px rgba(111, 168, 0, 0.12);
        transition: transform 0.2s;
    }

    .review-page .product-thumb-fallback {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        flex-shrink: 0;
        background: linear-gradient(135deg, #f0fae6, #d4f09b);
        color: #6fa800;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        border: 1px solid rgba(136, 210, 0, 0.18);
    }

    .review-page .table-green-white tbody tr:hover .product-thumb,
    .review-page .table-green-white tbody tr:hover .product-thumb-fallback {
        transform: scale(1.08);
    }

    .review-page .product-name {
        font-weight: 700;
        color: #1a1a1a;
        white-space: nowrap;
        transition: 0.15s;
    }

    .review-page .table-green-white tbody tr:hover .product-name {
        color: #6fa800;
    }

    .review-page .customer-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .review-page .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #88d200, #6fa800);
        color: white;
        font-weight: 700;
        font-size: 0.78rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 10px rgba(136, 210, 0, 0.3);
        transition: transform 0.2s;
    }

    .review-page .table-green-white tbody tr:hover .user-avatar {
        transform: scale(1.08);
    }

    .review-page .user-name {
        font-weight: 700;
        color: #1a1a1a;
        white-space: nowrap;
    }

    .review-page .user-email {
        color: #5c7a2e;
        font-weight: 600;
        font-size: 0.78rem;
        white-space: nowrap;
    }

    .review-page .message-cell {
        color: #333c33;
        max-width: 360px;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        line-height: 1.5;
        font-size: 1rem;
    }

    /* star rating */
    .review-page .stars-cell {
        display: flex;
        align-items: center;
        gap: 8px;
        white-space: nowrap;
    }

    .review-page .stars {
        color: #ffc107;
        font-size: 0.85rem;
        letter-spacing: 1px;
    }

        .review-page .stars .far {
            color: #e2e2e2;
        }

    .review-page .rating-num {
        background: #f0fae6;
        color: #4c7800;
        font-weight: 700;
        font-size: 0.76rem;
        padding: 3px 9px;
        border-radius: 60px;
        border: 1px solid #d4f09b;
    }

    /* action buttons — locked to a single row; scrolls horizontally on very narrow screens instead of wrapping */
    .review-page .actions-wrap {
        display: flex;
        flex-wrap: nowrap;
        align-items: center;
        gap: 6px;
        justify-content: flex-end;
        overflow-x: auto;
        scrollbar-width: none;
    }

        .review-page .actions-wrap::-webkit-scrollbar {
            display: none;
        }

    .review-page .btn-action {
        border-radius: 60px;
        padding: 7px 14px;
        font-weight: 600;
        font-size: 0.72rem;
        letter-spacing: 0.2px;
        transition: all 0.25s cubic-bezier(0.2, 0, 0, 1);
        border: 1px solid transparent;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        text-decoration: none;
        line-height: 1;
        cursor: pointer;
        white-space: nowrap;
        flex-shrink: 0;
    }

    .review-page .btn-delete {
        background: transparent;
        color: #a51b1b;
        border: 1.5px solid #f0c8c8;
    }

        .review-page .btn-delete:hover {
            background: #dc3545;
            color: white;
            border-color: #dc3545;
            transform: translateY(-3px) scale(1.04);
            box-shadow: 0 12px 24px rgba(220, 53, 69, 0.25);
        }

    /* footer */
    .review-page .table-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1.6rem;
        padding-top: 1rem;
        border-top: 1px solid rgba(136, 210, 0, 0.12);
        color: #6c757d;
        font-size: 0.84rem;
        flex-wrap: wrap;
        gap: 10px;
    }

        .review-page .table-footer i {
            color: #88d200;
            margin: 0 4px;
        }

        .review-page .table-footer .pill {
            background: #f0fae6;
            padding: 0.2rem 1.2rem;
            border-radius: 60px;
            color: #2d2d2d;
            font-weight: 500;
            transition: 0.15s;
        }

            .review-page .table-footer .pill:hover {
                background: #88d200;
                color: white;
            }

    /* ===== DELETE MODAL ===== */
    .review-page .delete-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(8px);
        z-index: 10000;
        display: none;
        align-items: center;
        justify-content: center;
        animation: fadeInOverlayRv 0.3s ease;
    }

    @@keyframes fadeInOverlayRv {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    .review-page .delete-modal {
        background: #ffffff;
        border-radius: 24px;
        padding: 2.5rem;
        max-width: 460px;
        width: 90%;
        position: relative;
        animation: modalSlideUpRv 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
        text-align: center;
    }

    @@keyframes modalSlideUpRv {
        from {
            transform: scale(0.8) translateY(40px);
            opacity: 0;
        }

        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .review-page .delete-modal .modal-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, #fff5f5, #ffe8e8);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.5rem;
        font-size: 2.5rem;
        color: #dc3545;
        animation: pulseIconRv 1.5s ease-in-out infinite;
    }

    @@keyframes pulseIconRv {
        0%, 100% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }
    }

    .review-page .delete-modal h3 {
        color: #1a1a2e;
        font-weight: 700;
        margin-bottom: 0.5rem;
        font-size: 1.5rem;
    }

    .review-page .delete-modal p {
        color: #6c757d;
        font-size: 0.95rem;
        line-height: 1.6;
        margin-bottom: 1.5rem;
    }

    .review-page .delete-modal .modal-user-preview {
        background: #f9fdf2;
        border: 1px solid rgba(136, 210, 0, 0.18);
        border-radius: 14px;
        padding: 12px 16px;
        margin-bottom: 1.4rem;
        text-align: left;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .review-page .delete-modal .modal-user-preview img,
        .review-page .delete-modal .modal-user-preview .mu-fallback {
            width: 44px;
            height: 44px;
            border-radius: 10px;
            object-fit: cover;
            flex-shrink: 0;
            background: linear-gradient(135deg, #f0fae6, #d4f09b);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #6fa800;
        }

        .review-page .delete-modal .modal-user-preview .mu-text {
            min-width: 0;
        }

        .review-page .delete-modal .modal-user-preview .mu-name {
            font-weight: 700;
            color: #1a1a1a;
            font-size: 0.92rem;
        }

        .review-page .delete-modal .modal-user-preview .mu-msg {
            color: #6c757d;
            font-size: 0.82rem;
            margin-top: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

    .review-page .delete-modal .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
    }

    .review-page .delete-modal .btn-cancel {
        background: #f1f3f5;
        color: #495057;
        border: none;
        border-radius: 50px;
        padding: 0.7rem 2rem;
        font-weight: 600;
        transition: all 0.3s ease;
        cursor: pointer;
        flex: 1;
    }

        .review-page .delete-modal .btn-cancel:hover {
            background: #e9ecef;
            transform: scale(1.02);
        }

    .review-page .delete-modal .btn-confirm-delete {
        background: linear-gradient(135deg, #dc3545, #b02a37);
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: 0.7rem 2rem;
        font-weight: 600;
        transition: all 0.3s cubic-bezier(0.2, 0.9, 0.4, 1);
        cursor: pointer;
        flex: 1;
        box-shadow: 0 4px 15px rgba(220, 53, 69, 0.3);
        text-decoration: none;
        display: inline-block;
    }

        .review-page .delete-modal .btn-confirm-delete:hover {
            transform: scale(1.02) translateY(-2px);
            box-shadow: 0 8px 25px rgba(220, 53, 69, 0.4);
            background: linear-gradient(135deg, #c82333, #a71d2a);
        }

    /* ===== SUCCESS TOAST ===== */
    .review-page .toast-container-custom {
        position: fixed;
        top: 30px;
        right: 30px;
        z-index: 9999;
        min-width: 320px;
        max-width: 450px;
        pointer-events: none;
    }

    .review-page .toast-success {
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(10px);
        border-left: 8px solid #88d200;
        border-radius: 20px;
        box-shadow: 0 20px 60px -12px rgba(0, 0, 0, 0.25), 0 4px 20px rgba(136, 210, 0, 0.12);
        padding: 20px 28px;
        color: #1a1a2e;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 16px;
        opacity: 1;
        pointer-events: none;
        animation: slideInRightRv 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes slideInRightRv {
        from {
            transform: translateX(120%) scale(0.9);
            opacity: 0;
        }

        to {
            transform: translateX(0) scale(1);
            opacity: 1;
        }
    }

    .review-page .toast-success i {
        font-size: 2rem;
        color: #88d200;
        background: linear-gradient(135deg, #f0fae6, #d4f09b);
        padding: 12px;
        border-radius: 50%;
        box-shadow: 0 2px 10px rgba(136, 210, 0, 0.15);
        animation: checkBounceRv 0.6s ease;
    }

    @@keyframes checkBounceRv {
        0% {
            transform: scale(0);
        }

        50% {
            transform: scale(1.2);
        }

        70% {
            transform: scale(0.9);
        }

        100% {
            transform: scale(1);
        }
    }

    .review-page .toast-success .toast-content {
        flex: 1;
    }

    .review-page .toast-success .toast-title {
        font-weight: 700;
        color: #1a1a2e;
        font-size: 1rem;
    }

    .review-page .toast-success .toast-message {
        color: #6c757d;
        font-size: 0.9rem;
        margin-top: 2px;
    }

    .review-page .fade-out {
        animation: fadeOutRv 0.5s cubic-bezier(0.2, 0.9, 0.4, 1) forwards;
    }

    @@keyframes fadeOutRv {
        0% {
            opacity: 1;
            transform: scale(1) translateY(0);
        }

        100% {
            opacity: 0;
            transform: scale(0.8) translateY(-20px);
        }
    }

    /* responsive */
    @@media (max-width: 768px) {
        .review-page .admin-card {
            padding: 1.2rem;
        }

        .review-page .heading-green {
            font-size: 1.45rem;
        }

        .review-page .brand-icon {
            width: 40px;
            height: 40px;
            font-size: 1.25rem;
        }

        .review-page .table-green-white thead th,
        .review-page .table-green-white tbody td {
            padding: 10px 10px;
            font-size: 0.84rem;
        }

        .review-page .btn-action {
            padding: 6px 12px;
            font-size: 0.7rem;
        }

        .review-page .actions-wrap {
            gap: 4px;
        }

        .review-page .table-green-white tbody td:first-child {
            padding-left: 14px;
        }

        .review-page .table-green-white tbody td:last-child {
            padding-right: 14px;
        }

        .review-page .toast-container-custom {
            top: 20px;
            right: 20px;
            left: 20px;
            min-width: unset;
            max-width: unset;
        }

        .review-page .delete-modal {
            padding: 2rem 1.5rem;
        }

            .review-page .delete-modal .modal-actions {
                flex-direction: column;
            }

        .review-page .stats-row {
            grid-template-columns: 1fr;
        }

        .review-page .toolbar-row {
            flex-direction: column;
            align-items: stretch;
        }

        .review-page .search-box {
            max-width: unset;
        }

        .review-page .toolbar-right {
            justify-content: space-between;
        }
    }

    @@media (max-width: 576px) {
        .review-page .header-section {
            flex-direction: column;
            align-items: start;
            gap: 0.8rem;
        }
    }
</style>

<div class="review-page">
    <div class="container-cust">
        <div class="admin-card">

            <!-- header -->
            <div class="header-section">
                <div class="brand-head">
                    <div class="brand-icon">
                        <i class="fas fa-star"></i>
                    </div>
                    <h1 class="heading-green">
                        Product Reviews
                        <span>@Model.Count()</span>
                    </h1>
                </div>
                <div class="header-actions">
                    <div class="status-badge">
                        <i class="fas fa-circle" style="font-size: 0.5rem;"></i> admin view
                    </div>
                </div>
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="alert-success-cust">
                    <i class="fas fa-check-circle"></i> @TempData["Message"]
                </div>
            }

            @if (!Model.Any())
            {
                <div class="alert-info-cust">
                    <i class="fas fa-comment-slash"></i>
                    No product reviews have been submitted yet.
                </div>
            }
            else
            {
                var avgRating = Model.Average(x => x.Ratings);

                <!-- stat cards -->
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-star"></i></div>
                        <div>
                            <div class="stat-value">@Model.Count()</div>
                            <div class="stat-label">Total Reviews</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-chart-line"></i></div>
                        <div>
                            <div class="stat-value">@avgRating.ToString("0.0") / 5</div>
                            <div class="stat-label">Average Rating</div>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon"><i class="fas fa-box-open"></i></div>
                        <div>
                            <div class="stat-value">@Model.Select(x => x.ProductId).Distinct().Count()</div>
                            <div class="stat-label">Products Reviewed</div>
                        </div>
                    </div>
                </div>

                <!-- search / toolbar -->
                <div class="toolbar-row">
                    <div class="search-box">
                        <i class="fas fa-search"></i>
                        <input type="text" id="reviewSearch" placeholder="Search by product, user or review..." onkeyup="filterReviews()" />
                    </div>
                    <div class="toolbar-right">
                        <div class="rating-filter" id="ratingFilter">
                            <span class="rating-chip active" data-rating="all" onclick="filterByRating('all', this)">All</span>
                            <span class="rating-chip" data-rating="5" onclick="filterByRating('5', this)">5 <i class="fas fa-star" style="font-size:0.6rem;"></i></span>
                            <span class="rating-chip" data-rating="4" onclick="filterByRating('4', this)">4 <i class="fas fa-star" style="font-size:0.6rem;"></i></span>
                            <span class="rating-chip" data-rating="3" onclick="filterByRating('3', this)">3 <i class="fas fa-star" style="font-size:0.6rem;"></i></span>
                            <span class="rating-chip" data-rating="2" onclick="filterByRating('2', this)">2 <i class="fas fa-star" style="font-size:0.6rem;"></i></span>
                            <span class="rating-chip" data-rating="1" onclick="filterByRating('1', this)">1 <i class="fas fa-star" style="font-size:0.6rem;"></i></span>
                        </div>
                        <span class="result-count" id="resultCount">@Model.Count() of @Model.Count() shown</span>
                        <span class="scroll-hint">
                            <i class="fas fa-arrows-left-right"></i> click &amp; drag to scroll
                        </span>
                    </div>
                </div>

                <!-- table -->
                <div class="table-responsive-cust" id="reviewTableScroll">
                    <table class="table table-green-white">
                        <thead>
                            <tr>
                                <th class="sortable" onclick="sortReviewTable(0, this)"><span class="th-inner"><i class="fas fa-box fa-fw-lead"></i> Product <i class="fas fa-sort sort-icon"></i></span></th>
                                <th class="sortable" onclick="sortReviewTable(1, this)"><span class="th-inner"><i class="fas fa-user fa-fw-lead"></i> Reviewer <i class="fas fa-sort sort-icon"></i></span></th>
                                <th class="sortable" onclick="sortReviewTable(2, this)"><span class="th-inner"><i class="fas fa-star fa-fw-lead"></i> Rating <i class="fas fa-sort sort-icon"></i></span></th>
                                <th><span class="th-inner"><i class="fas fa-comment fa-fw-lead"></i> Review</span></th>
                                <th class="text-end"><span class="th-inner"><i class="fas fa-bolt fa-fw-lead"></i> Actions</span></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int rowIndex = 0;
                            }
                            @foreach (var item in Model)
                            {
                                rowIndex++;
                                var userName = item.User?.UserName ?? "Unknown";
                                var userEmail = item.User?.Email ?? "";
                                var productName = item.Product?.Name ?? "Deleted product";
                                // Images physically live in wwwroot/images/products, and only get served from the
                                // "/images/products/" URL regardless of what the DB column stores (a bare filename,
                                // a relative path, or even a full Windows path) — so we strip everything down to just
                                // the filename and rebuild the path ourselves instead of relying on the stored value.
                                var productImageRaw = item.Product?.Image1; // NOTE: rename if your property is Image/ImagePath/ProductImage
                                var productImageFile = string.IsNullOrEmpty(productImageRaw) ? null : System.IO.Path.GetFileName(productImageRaw);
                                var productImage = string.IsNullOrEmpty(productImageFile) ? null : "/images/products/" + productImageFile;
                                var fullStars = (int)Math.Round(item.Ratings);
                                <tr style="--i: @rowIndex;" data-review-id="@item.Id" data-rating="@item.Ratings">
                                    <td>
                                        <div class="product-cell">
                                            @if (!string.IsNullOrEmpty(productImage))
                                            {
                                                <img src="@productImage" class="product-thumb" alt="@productName" onerror="this.onerror=null;this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                                <div class="product-thumb-fallback" style="display:none;"><i class="fas fa-image"></i></div>
                                            }
                                            else
                                            {
                                                <div class="product-thumb-fallback"><i class="fas fa-image"></i></div>
                                            }
                                            <span class="product-name">@productName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="customer-cell">
                                            <div class="user-avatar">@(string.IsNullOrEmpty(userName) ? "?" : userName.Substring(0, 1).ToUpper())</div>
                                            <div>
                                                <div class="user-name">@userName</div>
                                                <div class="user-email">@userEmail</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="stars-cell">
                                            <span class="stars">
                                                @for (int s = 1; s <= 5; s++)
                                                {
                                                    if (s <= fullStars)
                                                    {
                                                        <i class="fas fa-star"></i>
                                                    }
                                                    else
                                                    {
                                                        <i class="far fa-star"></i>
                                                    }
                                                }
                                            </span>
                                            <span class="rating-num">@item.Ratings.ToString("0.0")</span>
                                        </div>
                                    </td>
                                    <td><span class="message-cell">@item.ReviewMessage</span></td>
                                    <td style="text-align: right;">
                                        <div class="actions-wrap">
                                            <button type="button" class="btn-action btn-delete"
                                                    onclick="openDeleteModal('@item.Id', '@Html.Raw(Html.Encode(productName).Replace("'", "\\'"))', '@Html.Raw(Html.Encode(userName).Replace("'", "\\'"))', '@Html.Raw(Html.Encode(item.ReviewMessage).Replace("'", "\\'"))', '@Html.Raw(productImage ?? "")')">
                                                <i class="fas fa-trash-alt"></i> Delete
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                            <tr class="empty-state-row" id="noResultsRow" style="display: none;">
                                <td colspan="5">
                                    <i class="fas fa-inbox"></i>
                                    No matching reviews found.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- footer -->
                <div class="table-footer">
                    <span>
                        <i class="fas fa-arrow-right"></i> hover rows · click headers to sort · filter by rating · green theme
                    </span>
                    <span class="pill">
                        <i class="fas fa-star"></i> @Model.Count() review entries
                    </span>
                </div>
            }

        </div>
    </div>

    <!-- ===== DELETE CONFIRMATION MODAL ===== -->
    <div id="deleteModal" class="delete-modal-overlay">
        <div class="delete-modal">
            <div class="modal-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            <h3>Delete This Review?</h3>
            <p>
                Are you sure you want to delete this product review?
                <br>
                <small style="color: #dc3545; font-weight: 500;">
                    <i class="fas fa-exclamation-circle"></i> This action cannot be undone.
                </small>
            </p>
            <div class="modal-user-preview" id="modalUserPreview">
                <img id="modalProductImg" src="" alt="" style="display:none;" />
                <div id="modalProductFallback" class="mu-fallback"><i class="fas fa-image"></i></div>
                <div class="mu-text">
                    <div class="mu-name" id="modalProductName">—</div>
                    <div class="mu-msg" id="modalUserMsg">—</div>
                </div>
            </div>
            <div class="modal-actions">
                <button class="btn-cancel" onclick="closeDeleteModal()">
                    <i class="fas fa-times"></i> Cancel
                </button>
                <a href="#" class="btn-confirm-delete" id="confirmDeleteBtn">
                    <i class="fas fa-trash-alt"></i> Yes, Delete
                </a>
            </div>
        </div>
    </div>

    <!-- ===== SUCCESS TOAST ===== -->
    <div id="successToast" class="toast-container-custom">
        <div id="toastMessage" class="toast-success" style="display: none;">
            <i class="fas fa-check-circle"></i>
            <div class="toast-content">
                <div class="toast-title">Deleting...</div>
                <div class="toast-message" id="toastText">Redirecting to delete confirmation</div>
            </div>
        </div>
    </div>
</div>

<script>
    let deleteReviewId = null;

    // Live search filter across product, user and review text
    function filterReviews() {
        applyFilters();
    }

    let activeRatingFilter = 'all';
    function filterByRating(rating, chipEl) {
        activeRatingFilter = rating;
        document.querySelectorAll('#ratingFilter .rating-chip').forEach(c => c.classList.remove('active'));
        chipEl.classList.add('active');
        applyFilters();
    }

    function applyFilters() {
        const query = document.getElementById('reviewSearch').value.trim().toLowerCase();
        const rows = document.querySelectorAll('.review-page .table-green-white tbody tr:not(#noResultsRow)');
        let visibleCount = 0;

        rows.forEach(row => {
            const text = row.textContent.toLowerCase();
            const matchesSearch = text.includes(query);

            const rowRating = Math.round(parseFloat(row.getAttribute('data-rating')));
            const matchesRating = activeRatingFilter === 'all' || rowRating === parseInt(activeRatingFilter, 10);

            const visible = matchesSearch && matchesRating;
            row.style.display = visible ? '' : 'none';
            if (visible) visibleCount++;
        });

        document.getElementById('noResultsRow').style.display = visibleCount === 0 ? '' : 'none';

        const totalRows = rows.length;
        const countEl = document.getElementById('resultCount');
        if (countEl) countEl.textContent = `${visibleCount} of ${totalRows} shown`;
    }

    // Click-to-sort table columns
    let reviewSortDirections = {};
    function sortReviewTable(colIndex, headerEl) {
        const table = headerEl.closest('table');
        const tbody = table.querySelector('tbody');
        const rows = Array.from(tbody.querySelectorAll('tr:not(#noResultsRow)'));

        const asc = !reviewSortDirections[colIndex];
        reviewSortDirections = {};
        reviewSortDirections[colIndex] = asc;

        table.querySelectorAll('thead th').forEach(th => th.classList.remove('sort-asc', 'sort-desc'));
        headerEl.classList.add(asc ? 'sort-asc' : 'sort-desc');

        rows.sort((a, b) => {
            let cellA, cellB;
            if (colIndex === 2) {
                cellA = parseFloat(a.getAttribute('data-rating')) || 0;
                cellB = parseFloat(b.getAttribute('data-rating')) || 0;
                return asc ? cellA - cellB : cellB - cellA;
            }
            cellA = a.children[colIndex].textContent.trim().toLowerCase();
            cellB = b.children[colIndex].textContent.trim().toLowerCase();
            const cmp = cellA.localeCompare(cellB);
            return asc ? cmp : -cmp;
        });

        rows.forEach(row => tbody.insertBefore(row, document.getElementById('noResultsRow')));
    }

    function openDeleteModal(reviewId, productName, userName, message, productImage) {
        deleteReviewId = reviewId;
        document.getElementById('modalProductName').textContent = productName || 'Unknown product';
        document.getElementById('modalUserMsg').textContent = (userName ? userName + ': ' : '') + (message || '');

        const img = document.getElementById('modalProductImg');
        const fallback = document.getElementById('modalProductFallback');
        if (productImage) {
            img.src = productImage;
            img.style.display = 'block';
            fallback.style.display = 'none';
            img.onerror = function () {
                img.style.display = 'none';
                fallback.style.display = 'flex';
            };
        } else {
            img.style.display = 'none';
            fallback.style.display = 'flex';
        }

        const confirmBtn = document.getElementById('confirmDeleteBtn');
        confirmBtn.setAttribute('href', '@Url.Action("DeleteproductreviewLogic", "Admin")/' + reviewId);

        const modal = document.getElementById('deleteModal');
        modal.style.display = 'flex';

        const modalContent = modal.querySelector('.delete-modal');
        modalContent.style.animation = 'none';
        setTimeout(() => {
            modalContent.style.animation = 'modalSlideUpRv 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        }, 10);
    }

    function closeDeleteModal() {
        document.getElementById('deleteModal').style.display = 'none';
        deleteReviewId = null;
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', function (e) {
        e.preventDefault();
        if (!deleteReviewId) return;

        const targetUrl = this.getAttribute('href');
        const row = document.querySelector(`tr[data-review-id="${deleteReviewId}"]`);
        closeDeleteModal();
        showSuccessToast('Deleting...', 'Removing this product review.');

        if (row) row.classList.add('fade-out');

        setTimeout(() => {
            window.location.href = targetUrl;
        }, 700);
    });

    document.getElementById('deleteModal').addEventListener('click', function (e) {
        if (e.target === this) closeDeleteModal();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeDeleteModal();
    });

    function showSuccessToast(title, message) {
        const toast = document.getElementById('toastMessage');
        const textSpan = document.getElementById('toastText');
        const titleEl = toast.querySelector('.toast-title');

        if (titleEl) titleEl.innerText = title;
        if (textSpan) textSpan.innerText = message;

        toast.style.display = 'flex';

        toast.style.animation = 'none';
        setTimeout(() => {
            toast.style.animation = 'slideInRightRv 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275)';
        }, 10);
    }

    // ===== Click & drag horizontal scrolling for the table (no need to hunt for a scrollbar) =====
    (function () {
        const scroller = document.getElementById('reviewTableScroll');
        if (!scroller) return;

        let isDown = false;
        let startX;
        let scrollLeftStart;

        scroller.addEventListener('mousedown', (e) => {
            isDown = true;
            scroller.classList.add('dragging');
            startX = e.pageX - scroller.offsetLeft;
            scrollLeftStart = scroller.scrollLeft;
        });

        window.addEventListener('mouseup', () => {
            isDown = false;
            scroller.classList.remove('dragging');
        });

        scroller.addEventListener('mouseleave', () => {
            isDown = false;
            scroller.classList.remove('dragging');
        });

        scroller.addEventListener('mousemove', (e) => {
            if (!isDown) return;
            e.preventDefault();
            const x = e.pageX - scroller.offsetLeft;
            const walk = (x - startX);
            scroller.scrollLeft = scrollLeftStart - walk;
        });

        // touch support
        let touchStartX = 0;
        let touchScrollStart = 0;
        scroller.addEventListener('touchstart', (e) => {
            touchStartX = e.touches[0].pageX;
            touchScrollStart = scroller.scrollLeft;
        }, { passive: true });

        scroller.addEventListener('touchmove', (e) => {
            const dx = e.touches[0].pageX - touchStartX;
            scroller.scrollLeft = touchScrollStart - dx;
        }, { passive: true });
    })();
</script>
