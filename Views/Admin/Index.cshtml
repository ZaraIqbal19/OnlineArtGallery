                            <p class="stat-value">@ViewBag.TotalCustomers</p>
                            <span class="stat-label">Customers</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-4">
                <div class="card stat-card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div class="stat-icon stat-icon-1"><i class="bx bx-star"></i></div>
