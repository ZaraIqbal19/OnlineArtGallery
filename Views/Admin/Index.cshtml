            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card stat-card h-100">
                    <div class="card-header"><h5 class="card-title mb-0">Income — Last 7 Days</h5></div>
                    <div class="card-body px-0">
                        <div class="d-flex p-4 pt-3 min-width-0">
                            <div class="avatar flex-shrink-0 me-3"><img src="~/Admin/assets/img/icons/unicons/wallet.png" alt="income" /></div>
                            <div class="min-width-0">
                                <small class="text-muted d-block">This Week's Revenue</small>
                                <div class="d-flex align-items-center flex-wrap">
                                    <h6 class="mb-0 me-1 text-truncate" title="$@(((decimal)ViewBag.WeeklyRevenueTotal).ToString("N0"))">
                                        $@(((decimal)ViewBag.WeeklyRevenueTotal).ToString("N0"))
                                    </h6>
                                    @{
                                        var diff = (decimal)ViewBag.WeeklyRevenueDiff;
                                    }
                                    <small class="@(diff >= 0 ? "text-success" : "text-danger") fw-semibold stat-trend">
                                        <i class="bx @(diff >= 0 ? "bx-chevron-up" : "bx-chevron-down")"></i>
                                        $@Math.Abs(diff).ToString("N0") vs prior week
                                    </small>
                                </div>
                            </div>
                        </div>
                        <div id="incomeChart"></div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 col-lg-4 mb-4">
                <div class="card stat-card h-100 list-card">
                    <div class="card-header"><h5 class="card-title m-0">Recent Transactions</h5></div>
                    <div class="card-body">
                        @if (recentTransactions != null && recentTransactions.Any())
                        {
                            foreach (var t in recentTransactions)
                            {
                                <div class="list-row">
                                    <div class="avatar flex-shrink-0"><img src="~/Admin/assets/img/icons/unicons/wallet.png" alt="txn" class="rounded" /></div>
                                    <div class="list-row-text">
                                        <small class="text-muted d-block">@t.Method</small>
                                        <span class="truncate fw-semibold" title="@t.ProductName">@t.ProductName</span>
                                    </div>
                                    <span class="fw-semibold flex-shrink-0 text-success">+$@(((decimal)t.Amount).ToString("N0"))</span>
                                </div>
                            }
                        }
                        else
                        {
                            <p class="text-muted mb-0">No transactions yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ TOP PERFORMERS ============ -->
        <div class="section-title"><i class="bx bx-trophy"></i> Top Performers</div>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card stat-card h-100 list-card">
                    <div class="card-header"><h5 class="card-title m-0">Top Products by Revenue</h5></div>
                    <div class="card-body">
                        @if (topProducts != null && topProducts.Any())
                        {
                            var maxRev = MaxOf(topProducts, p => (decimal)p.Revenue);
                            int rank = 1;
                            foreach (var p in topProducts)
                            {
                                <div class="list-row">
                                    <div class="rank-badge">@rank</div>
                                    <div class="list-row-text">
                                        <div class="d-flex justify-content-between">
                                            <span class="truncate fw-semibold" title="@p.Name">@p.Name</span>
                                            <span class="text-success fw-semibold flex-shrink-0">$@(((decimal)p.Revenue).ToString("N0"))</span>
                                        </div>
                                        <div class="mini-bar"><div style="width:@(((decimal)p.Revenue / maxRev) * 100)%"></div></div>
                                        <small class="text-muted">@p.Qty sold</small>
                                    </div>
                                </div>
                                rank++;
                            }
                        }
                        else
                        {

                            <p class="text-muted mb-0">No product sales yet.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card stat-card h-100 list-card">
                    <div class="card-header"><h5 class="card-title m-0">Top Sellers by Revenue</h5></div>
                    <div class="card-body">
                        @if (topSellers != null && topSellers.Any())
                        {
                            var maxRev = MaxOf(topSellers, s => (decimal)s.Revenue);
                            int rank = 1;
                            foreach (var s in topSellers)
                            {
                                <div class="list-row">
                                    <div class="rank-badge">@rank</div>
                                    <div class="list-row-text">
                                        <div class="d-flex justify-content-between">
                                            <span class="truncate fw-semibold" title="@s.UserName">@s.UserName</span>
                                            <span class="text-success fw-semibold flex-shrink-0">$@(((decimal)s.Revenue).ToString("N0"))</span>
                                        </div>
                                        <div class="mini-bar"><div style="width:@(((decimal)s.Revenue / maxRev) * 100)%"></div></div>
                                        <small class="text-muted">@s.Sales sales</small>
                                    </div>
                                </div>
                                rank++;
                            }
                        }
                        else
                        {

                            <p class="text-muted mb-0">No seller activity yet.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card stat-card h-100 list-card">
                    <div class="card-header"><h5 class="card-title m-0">Top Customers by Spend</h5></div>
                    <div class="card-body">
                        @if (topCustomers != null && topCustomers.Any())
                        {
                            var maxSpent = MaxOf(topCustomers, c => (decimal)c.Spent);
                            int rank = 1;
                            foreach (var c in topCustomers)
                            {
                                <div class="list-row">
                                    <div class="rank-badge">@rank</div>
                                    <div class="list-row-text">
                                        <div class="d-flex justify-content-between">
                                            <span class="truncate fw-semibold" title="@c.UserName">@c.UserName</span>
                                            <span class="text-success fw-semibold flex-shrink-0">$@(((decimal)c.Spent).ToString("N0"))</span>
                                        </div>
                                        <div class="mini-bar"><div style="width:@(((decimal)c.Spent / maxSpent) * 100)%"></div></div>
                                        <small class="text-muted">@c.Orders orders</small>
                                    </div>
                                </div>
                                rank++;
                            }
                        }
                        else
                        {

                            <p class="text-muted mb-0">No customer activity yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ PAYMENTS + CATEGORY REVENUE ============ -->
        <div class="section-title"><i class="bx bx-wallet"></i> Payments &amp; Category Revenue</div>
        <div class="row">
            <div class="col-md-5 mb-4">
                <div class="card stat-card h-100">
                    <div class="card-header"><h5 class="card-title m-0">Payment Methods</h5></div>
                    <div class="card-body d-flex align-items-center gap-4">
                        <div id="paymentMethodsChart" class="flex-shrink-0"></div>
                        <div class="flex-grow-1 min-width-0">
                            @if (paymentBreakdown != null)
                            {
                                foreach (var p in paymentBreakdown)
                                {
                                    <div class="d-flex justify-content-between mb-2 min-width-0">
                                        <span class="truncate" title="@p.Method">@p.Method</span>
                                        <span class="fw-semibold flex-shrink-0">$@(((decimal)p.Revenue).ToString("N0")) · @p.Count</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-7 mb-4">
                <div class="card stat-card h-100 list-card">
                    <div class="card-header"><h5 class="card-title m-0">Revenue by Category</h5></div>
                    <div class="card-body">
                        @if (categoryRevenue != null && categoryRevenue.Any())
                        {
                            var maxRev = MaxOf(categoryRevenue, c => (decimal)c.Revenue);
                            foreach (var c in categoryRevenue)
                            {
                                <div class="list-row">
                                    <div class="list-row-text">
                                        <div class="d-flex justify-content-between">
                                            <span class="truncate fw-semibold" title="@c.Category">@c.Category</span>
                                            <span class="text-success fw-semibold flex-shrink-0">$@(((decimal)c.Revenue).ToString("N0"))</span>
                                        </div>
                                        <div class="mini-bar"><div style="width:@(((decimal)c.Revenue / maxRev) * 100)%"></div></div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {

                            <p class="text-muted mb-0">No category revenue yet.</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ COMMUNITY ACTIVITY ============ -->
        <div class="section-title"><i class="bx bx-group"></i> Community Activity</div>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="card stat-card h-100 list-card">
                    <div class="card-header"><h5 class="card-title m-0">Recent Reviews</h5></div>
                    <div class="card-body">
                        @if (recentReviews != null && recentReviews.Any())
                        {
                            foreach (var r in recentReviews)
                            {
                                int filled = (int)Math.Round((float)r.Ratings);
                                <div class="list-row" style="flex-direction:column; align-items:flex-start;">
                                    <div class="d-flex justify-content-between w-100 min-width-0">
                                        <span class="truncate fw-semibold" title="@r.Product">@r.Product</span>
                                        <span class="flex-shrink-0">
                                            @for (int s = 1; s <= 5; s++)
                                            {
                                                <i class="bx bxs-star @(s <= filled ? "star-filled" : "star-empty")" style="font-size:.8rem"></i>
                                            }
                                        </span>
                                    </div>
                                    <small class="text-muted">@r.User</small>
                                </div>
                            }
                        }
                        else
                        {

                            <p class="text-muted mb-0">No reviews yet.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card stat-card h-100 list-card">
                    <div class="card-header"><h5 class="card-title m-0">Recent Feedback</h5></div>
                    <div class="card-body">
                        @if (recentFeedbacks != null && recentFeedbacks.Any())
                        {
                            foreach (var f in recentFeedbacks)
                            {
                                <div class="list-row" style="flex-direction:column; align-items:flex-start;">
                                    <span class="fw-semibold">@f.User</span>
                                    <small class="text-muted">@f.message</small>
                                </div>
                            }
                        }
                        else
                        {

                            <p class="text-muted mb-0">No feedback yet.</p>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4 mb-4">
                <div class="card stat-card h-100">
                    <div class="card-header"><h5 class="card-title m-0">User Demographics</h5></div>
                    <div class="card-body d-flex align-items-center gap-4">
                        <div id="genderChart" class="flex-shrink-0"></div>
                        <div class="min-width-0">
                            <div class="d-flex justify-content-between mb-1"><span>Male</span><span class="fw-semibold">@ViewBag.MaleCount</span></div>
                            <div class="d-flex justify-content-between mb-1"><span>Female</span><span class="fw-semibold">@ViewBag.FemaleCount</span></div>
                            <div class="d-flex justify-content-between mb-1"><span>Other</span><span class="fw-semibold">@ViewBag.OtherGenderCount</span></div>
                            <hr class="my-2" />
                            <div class="d-flex justify-content-between"><span>Avg. Age</span><span class="fw-semibold">@ViewBag.AverageAge</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ============ TOP BIDS ============ -->
        <div class="section-title"><i class="bx bx-gavel"></i> Top Auction Bids</div>
        <div class="row">
            <div class="col-12 mb-4">
                <div class="card stat-card">
                    <div class="card-body table-responsive">
                        <table class="table table-borderless mb-0">
                            <thead>
                                <tr class="text-muted" style="font-size:.8rem;text-transform:uppercase;">
                                    <th>Product</th>
                                    <th>Bidder</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (topBids != null && topBids.Any())
                                {
                                    foreach (var b in topBids)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-truncate" style="max-width:220px;" title="@b.Product">@b.Product</td>
                                            <td class="text-truncate" style="max-width:160px;" title="@b.Bidder">@b.Bidder</td>
                                            <td class="text-success fw-semibold">$@(((float)b.bidamount).ToString("N0"))</td>
                                            <td><span class="badge bg-label-primary">@b.bidstatus</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="4" class="text-muted">No bids yet.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const themeColors = { primary: '#88d200', dark: '#6fa800', light: '#d4f09b', ultraLight: '#f0fae6' };
        const monthLabels = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        const monthlyRevenueByYear = @Html.Raw(ViewBag.MonthlyRevenueByYearJson);
        const selectedYear = @selectedYear;

        new ApexCharts(document.querySelector('#totalRevenueChart'), {
            chart: { height: 300, type: 'bar', toolbar: { show: false }, animations: { easing: 'easeinout', speed: 500 } },
            series: [{ name: 'Revenue', data: monthlyRevenueByYear[selectedYear] }],
            xaxis: { categories: monthLabels },
            colors: [themeColors.primary],
            plotOptions: { bar: { borderRadius: 6, columnWidth: '45%' } },
            dataLabels: { enabled: false }
        }).render();

        const growthPercent = @(ViewBag.CompanyGrowthPercent ?? 0);
        new ApexCharts(document.querySelector('#growthChart'), {
            chart: { height: 140, type: 'radialBar', animations: { easing: 'easeinout', speed: 600 } },
            series: [Math.min(Math.max(growthPercent, 0), 100)],
            colors: [themeColors.primary],
            plotOptions: { radialBar: { hollow: { size: '60%' } } }
        }).render();

        const categoryNames = @Html.Raw(ViewBag.CategoryNamesJson);
        const categoryQuantities = @Html.Raw(ViewBag.CategoryQuantitiesJson);
        new ApexCharts(document.querySelector('#orderStatisticsChart'), {
            chart: { height: 120, width: 120, type: 'donut', animations: { easing: 'easeinout', speed: 500 } },
            series: categoryQuantities.length ? categoryQuantities : [1],
            labels: categoryNames.length ? categoryNames : ['No data'],
            colors: [themeColors.primary, themeColors.dark, themeColors.light, '#a8d98f'],
            legend: { show: false },
            dataLabels: { enabled: false }
        }).render();

        const weeklyLabels = @Html.Raw(ViewBag.WeeklyLabelsJson);
        const weeklyRevenue = @Html.Raw(ViewBag.WeeklyRevenueJson);
        new ApexCharts(document.querySelector('#incomeChart'), {
            chart: { height: 140, type: 'area', toolbar: { show: false }, animations: { easing: 'easeinout', speed: 500 } },
            series: [{ name: 'Revenue', data: weeklyRevenue }],
            xaxis: { categories: weeklyLabels },
            colors: [themeColors.dark],
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0, stops: [0, 90] } },
            dataLabels: { enabled: false }
        }).render();

        const approvedPercent = @ViewBag.ApprovedProductsPercent;
        new ApexCharts(document.querySelector('#profileReportChart'), {
            chart: { height: 70, width: 130, type: 'line', sparkline: { enabled: true } },
            series: [{ data: [approvedPercent, 50, approvedPercent, 80, approvedPercent] }],
            colors: [themeColors.primary]
        }).render();

        const paymentCounts = @Html.Raw(ViewBag.PaymentMethodCountsJson);
        const paymentLabels = @Html.Raw(ViewBag.PaymentMethodLabelsJson);
        new ApexCharts(document.querySelector('#paymentMethodsChart'), {
            chart: { height: 130, width: 130, type: 'donut', animations: { easing: 'easeinout', speed: 500 } },
            series: paymentCounts.length ? paymentCounts : [1],
            labels: paymentLabels.length ? paymentLabels : ['No data'],
            colors: [themeColors.primary, themeColors.dark, themeColors.light],
            legend: { show: false },
            dataLabels: { enabled: false }
        }).render();

        new ApexCharts(document.querySelector('#genderChart'), {
            chart: { height: 110, width: 110, type: 'donut', animations: { easing: 'easeinout', speed: 500 } },
            series: [@ViewBag.MaleCount, @ViewBag.FemaleCount, @ViewBag.OtherGenderCount],
            labels: ['Male', 'Female', 'Other'],
            colors: [themeColors.primary, themeColors.dark, themeColors.light],
            legend: { show: false },
            dataLabels: { enabled: false }
        }).render();

        // Subtle plaque tilt — a light 3D response to the cursor, skipped for reduced-motion users
        (function () {
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion) return;

            document.querySelectorAll('.stat-card').forEach(function (card) {
                card.style.transformStyle = 'preserve-3d';
                var glow = document.createElement('span');
                glow.className = 'spotlight';
                card.appendChild(glow);

                card.addEventListener('mousemove', function (e) {
                    var r = card.getBoundingClientRect();
                    var px = (e.clientX - r.left) / r.width - 0.5;
                    var py = (e.clientY - r.top) / r.height - 0.5;
                    card.style.transform =
                        'translateY(-6px) rotateX(' + (py * -5) + 'deg) rotateY(' + (px * 6) + 'deg)';
                    card.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
                    card.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
                });
                card.addEventListener('mouseleave', function () {
                    card.style.transform = '';
                });
            });
        })();

        // Scroll reveal — progressive enhancement only. If this never runs,
        // the original CSS fadeInUp keyframes already leave everything visible.
        (function () {
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion || !('IntersectionObserver' in window)) return;

            var targets = document.querySelectorAll('.stat-card, .list-card, .section-title');
            targets.forEach(function (el, i) {
                el.classList.add('reveal-pending');
                el.style.transitionDelay = (i % 3) * 70 + 'ms';
            });

            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('reveal-in');
                        entry.target.querySelectorAll('.stat-value').forEach(animateCountUp);
                        io.unobserve(entry.target);
                    }
                });
            }, { threshold: 0.12, rootMargin: '0px 0px -30px 0px' });

            targets.forEach(function (el) { io.observe(el); });

            // safety net: force everything visible shortly after load either way
            setTimeout(function () {
                targets.forEach(function (el) {
                    if (!el.classList.contains('reveal-in')) {
                        el.classList.add('reveal-in');
                        el.querySelectorAll('.stat-value').forEach(animateCountUp);
                    }
                });
            }, 2500);
        })();

        // Ripple feedback on buttons and dropdown items
        (function () {
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion) return;

            document.querySelectorAll('.btn-outline-primary, .dropdown-item').forEach(function (el) {
                el.addEventListener('click', function (e) {
                    var rect = el.getBoundingClientRect();
                    var ripple = document.createElement('span');
                    var size = Math.max(rect.width, rect.height);
                    ripple.className = 'ripple';
                    ripple.style.width = ripple.style.height = size + 'px';
                    ripple.style.left = (e.clientX - rect.left - size / 2) + 'px';
                    ripple.style.top = (e.clientY - rect.top - size / 2) + 'px';
                    el.appendChild(ripple);
                    ripple.addEventListener('animationend', function () { ripple.remove(); });
                });
            });
        })();

        // Numbers count up from zero the moment they become visible
        function animateCountUp(el) {
            var raw = el.textContent.trim();
            var match = raw.match(/^(\D*)([\d,]+(?:\.\d+)?)(.*)$/);
            if (!match) return;
            var prefix = match[1], numStr = match[2].replace(/,/g, ''), suffix = match[3];
            var isFloat = numStr.indexOf('.') !== -1;
            var target = parseFloat(numStr);
            if (isNaN(target)) return;
            var duration = 900, start = null;
            function step(ts) {
                if (!start) start = ts;
                var p = Math.min((ts - start) / duration, 1);
                var eased = 1 - Math.pow(1 - p, 3);
                var cur = target * eased;
                el.textContent = prefix + (isFloat ? cur.toFixed(1) : Math.round(cur).toLocaleString('en-US')) + suffix;
                if (p < 1) requestAnimationFrame(step); else el.textContent = raw;
            }
            requestAnimationFrame(step);
        }

        (function () {
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion) return;
            document.querySelectorAll('.hero-metric .val').forEach(animateCountUp);
        })();

        // Magnetic pull for the year-picker button
        (function () {
            var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            if (reduceMotion) return;

            document.querySelectorAll('.btn-outline-primary').forEach(function (btn) {
                btn.addEventListener('mousemove', function (e) {
                    var r = btn.getBoundingClientRect();
                    var mx = (e.clientX - r.left - r.width / 2) * 0.25;
                    var my = (e.clientY - r.top - r.height / 2) * 0.25;
                    btn.style.transform = 'translate(' + mx + 'px,' + my + 'px)';
                });
                btn.addEventListener('mouseleave', function () { btn.style.transform = ''; });
            });
        })();

        // Floating back-to-top control
        (function () {
            var btn = document.createElement('button');
            btn.className = 'back-to-top';
            btn.setAttribute('aria-label', 'Back to top');
            btn.innerHTML = '<i class="bx bx-up-arrow-alt"></i>';
            document.body.appendChild(btn);

            window.addEventListener('scroll', function () {
                if (window.scrollY > 420) btn.classList.add('show');
                else btn.classList.remove('show');
            }, { passive: true });

            btn.addEventListener('click', function () {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        })();
    </script>
}
