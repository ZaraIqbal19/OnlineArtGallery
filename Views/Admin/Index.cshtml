                            <span class="status-count">@pendingProducts</span>
                        </div>
                        <div class="status-row">
                            <span class="status-label">Rejected</span>
                            <div class="progress progress-green flex-grow-1"><div class="progress-bar" style="width:@(Pct(rejectedProducts, totalProducts))%"></div></div>
                            <span class="status-count">@rejectedProducts</span>
                        </div>
                    </div>
                </div>
