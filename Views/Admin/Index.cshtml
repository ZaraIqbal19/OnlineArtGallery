@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var revenueYears = (List<int>)ViewBag.RevenueYears;
    var selectedYear = (int)ViewBag.SelectedYear;
    var categoryBreakdown = ViewBag.CategoryBreakdown as IEnumerable<dynamic>;
    var recentTransactions = ViewBag.RecentTransactions as IEnumerable<dynamic>;
    var topProducts = ViewBag.TopProducts as IEnumerable<dynamic>;
    var topCustomers = ViewBag.TopCustomers as IEnumerable<dynamic>;
    var topSellers = ViewBag.TopSellers as IEnumerable<dynamic>;
    var paymentBreakdown = ViewBag.PaymentBreakdown as IEnumerable<dynamic>;
    var categoryRevenue = ViewBag.CategoryRevenue as IEnumerable<dynamic>;
    var recentReviews = ViewBag.RecentReviews as IEnumerable<dynamic>;
    var recentFeedbacks = ViewBag.RecentFeedbacks as IEnumerable<dynamic>;
    var topBids = ViewBag.TopBids as IEnumerable<dynamic>;
    string[] categoryIcons = { "bx-mobile-alt", "bx-closet", "bx-home-alt", "bx-football" };

    int totalOrders = (int)ViewBag.TotalOrdersCount;
    int ordersPending = (int)ViewBag.OrdersPending;
    int ordersProcessing = (int)ViewBag.OrdersProcessing;
    int ordersDispatched = (int)ViewBag.OrdersDispatched;
    int ordersDelivered = (int)ViewBag.OrdersDelivered;
    int ordersCancelled = (int)ViewBag.OrdersCancelled;
    int ordersRejected = (int)ViewBag.OrdersRejected;

    int totalProducts = (int)ViewBag.TotalProductsCount;
    int availableProducts = (int)ViewBag.AvailableProductsCount;
    int pendingProducts = (int)ViewBag.PendingProductsCount;
    int rejectedProducts = (int)ViewBag.RejectedProductsCount;

    double Pct(int part, int whole) => whole > 0 ? Math.Round((double)part / whole * 100, 1) : 0;
    decimal MaxOf(IEnumerable<dynamic> src, Func<dynamic, decimal> sel) =>
        src != null && src.Any() ? src.Max(sel) : 1;

    var pipelineSegments = new (string Label, int Count, string Color)[]
    {
        ("Pending", ordersPending, "#d9edb0"),
        ("Processing", ordersProcessing, "#bfe378"),
        ("Dispatched", ordersDispatched, "#a8d98f"),
        ("Delivered", ordersDelivered, "#88d200"),
        ("Cancelled", ordersCancelled, "#c9c9c9"),
        ("Rejected", ordersRejected, "#e07a7a"),
    };
}

<style>
    :root {
        --brand-1: #88d200;
        --brand-2: #6fa800;
        --brand-2-dark: #598c00;
        --brand-3: #d4f09b;
        --brand-4: #f0fae6;
        --ink: #212b16;
        --ink-soft: #3c4a2c;
        --muted: #5b6b58;
        --muted-strong: #435038;
        --canvas: #faf9f3;
        --canvas-line: #e8e4d4;
        --paper: #ffffff;
        --serif: "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Georgia, "Times New Roman", serif;
        --ease: cubic-bezier(.22,1,.36,1);
    }

    /* ================= atmosphere ================= */
    .content-wrapper {
        background-color: var(--canvas);
        background-image: repeating-linear-gradient(115deg, rgba(111,168,0,0.035) 0px, rgba(111,168,0,0.035) 1px, transparent 1px, transparent 34px), repeating-linear-gradient(25deg, rgba(111,168,0,0.03) 0px, rgba(111,168,0,0.03) 1px, transparent 1px, transparent 34px);
    }

    * {
        scrollbar-width: thin;
        scrollbar-color: var(--brand-1) transparent;
    }

    ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    ::-webkit-scrollbar-thumb {
        background: linear-gradient(var(--brand-1), var(--brand-2));
        border-radius: 10px;
    }

    ::-webkit-scrollbar-track {
        background: transparent;
    }

    a:focus-visible, button:focus-visible, .dropdown-item:focus-visible {
        outline: 2px solid var(--brand-2);
        outline-offset: 2px;
        border-radius: 4px;
    }

    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(16px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes riseIn {
        from {
            opacity: 0;
            transform: translateY(60%);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulseDot {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(255,255,255,0.55);
        }

        50% {
            box-shadow: 0 0 0 6px rgba(255,255,255,0);
        }
    }

    @@keyframes driftGrain {
        0% {
            transform: translate(0,0);
        }

        100% {
            transform: translate(-40px,-30px);
        }
    }

    @@keyframes underlineGrow {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        * {
            animation: none !important;
            transition: none !important;
        }
    }

    .text-primary {
        color: var(--brand-1) !important;
    }

    .btn-outline-primary {
        color: var(--brand-2-dark);
        border-color: var(--brand-1);
        font-weight: 600;
        transition: all .25s var(--ease);
    }

        .btn-outline-primary:hover {
            background-color: var(--brand-1);
            border-color: var(--brand-1);
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(136, 210, 0, 0.32);
        }

    .bg-label-primary {
        background-color: var(--brand-4);
        color: var(--brand-2-dark);
    }

    .bg-label-success {
        background-color: var(--brand-3);
        color: #395700;
    }

    .text-muted {
        color: var(--muted) !important;
    }

    /* ================= hero band : the gallery placard ================= */
    .hero-band {
        border-radius: 16px;
        padding: 2rem 2.25rem;
        margin-bottom: 2rem;
        background: radial-gradient(120% 160% at 100% 0%, rgba(255,255,255,0.16), transparent 55%), linear-gradient(120deg, #628f00 0%, #7fc400 52%, #a3dd45 100%);
        color: #fff;
        position: relative;
        overflow: hidden;
        box-shadow: 0 18px 40px -12px rgba(88, 130, 0, 0.45);
        animation: fadeInUp .55s var(--ease) both;
        border: 1px solid rgba(255,255,255,0.14);
    }

        .hero-band::after {
            content: '';
            position: absolute;
            inset: -20%;
            background-image: radial-gradient(rgba(255,255,255,0.35) 0.6px, transparent 0.6px);
            background-size: 5px 5px;
            opacity: .12;
            animation: driftGrain 14s linear infinite alternate;
            pointer-events: none;
        }

        .hero-band::before {
            content: '';
            position: absolute;
            right: -50px;
            bottom: -90px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,0.08);
        }

        /* museum-label corner brackets */
        .hero-band .corner {
            position: absolute;
            width: 22px;
            height: 22px;
            border: 1.5px solid rgba(255,255,255,0.55);
            opacity: .8;
        }

            .hero-band .corner.tl {
                top: 14px;
                left: 14px;
                border-right: none;
                border-bottom: none;
            }

            .hero-band .corner.br {
                bottom: 14px;
                right: 14px;
                border-left: none;
                border-top: none;
            }

    .hero-eyebrow {
        text-transform: uppercase;
        letter-spacing: .16em;
        font-size: .68rem;
        font-weight: 700;
        opacity: .85;
        margin-bottom: .5rem;
        display: block;
    }

    .hero-chip {
        background: rgba(255,255,255,0.2);
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 999px;
        padding: .3rem .85rem;
        font-size: .78rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
    }

        .hero-chip i {
            animation: pulseDot 2.2s ease-in-out infinite;
            border-radius: 50%;
        }

    .hero-title {
        font-family: var(--serif);
        font-size: 1.7rem;
        font-weight: 600;
        letter-spacing: .01em;
        margin-bottom: .3rem;
        text-shadow: 0 1px 3px rgba(0,0,0,0.12);
    }

    .hero-sub {
        opacity: .96;
        font-size: .93rem;
        margin-bottom: 0;
        position: relative;
        z-index: 1;
    }

    .hero-metric {
        text-align: right;
        position: relative;
        z-index: 1;
        transition: transform .25s var(--ease);
        padding: .35rem .5rem;
        border-radius: 10px;
    }

        .hero-metric:hover {
            transform: translateY(-3px);
            background: rgba(255,255,255,0.08);
        }

        .hero-metric .val {
            font-family: var(--serif);
            font-size: 1.75rem;
            font-weight: 600;
            line-height: 1.1;
            font-variant-numeric: tabular-nums;
        }

        .hero-metric .lbl {
            font-size: .68rem;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .9;
        }

    /* ================= section title : wall signage ================= */
    .section-title {
        font-family: var(--serif);
        font-weight: 600;
        color: var(--brand-2-dark);
        margin: 2.5rem 0 1.1rem;
        display: flex;
        align-items: baseline;
        gap: .65rem;
        font-size: 1.2rem;
        letter-spacing: .01em;
        animation: fadeInUp .45s var(--ease) both;
        position: relative;
    }

        .section-title i {
            font-size: 1.05rem;
            color: #fff;
            background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
            width: 30px;
            height: 30px;
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 4px 10px rgba(111,168,0,0.3);
            flex-shrink: 0;
        }

        .section-title::after {
            content: '';
            flex: 1;
            height: 1px;
            align-self: center;
            background: linear-gradient(90deg, var(--canvas-line), transparent);
        }

    /* ================= stat cards : gallery plaques ================= */
    .stat-card {
        border: 1px solid var(--canvas-line);
        border-radius: 14px;
        background: var(--paper);
        box-shadow: 0 2px 14px rgba(90, 120, 40, 0.07);
        transition: transform .3s var(--ease), box-shadow .3s var(--ease), border-color .3s var(--ease);
        height: 100%;
        position: relative;
        overflow: hidden;
        animation: fadeInUp .5s var(--ease) both;
        will-change: transform;
    }

        .stat-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, var(--brand-1), var(--brand-2));
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .4s var(--ease);
        }

        /* corner brackets, revealed on hover like a museum label */
        .stat-card::after {
            content: '';
            position: absolute;
            inset: 7px;
            border-radius: 9px;
            border: 1px dashed transparent;
            transition: border-color .3s var(--ease);
            pointer-events: none;
        }

        .stat-card:hover {
            transform: translateY(-6px) perspective(600px);
            box-shadow: 0 20px 34px -10px rgba(90, 120, 40, 0.28);
            border-color: rgba(136,210,0,0.35);
        }

            .stat-card:hover::before {
                transform: scaleX(1);
            }

            .stat-card:hover::after {
                border-color: rgba(136,210,0,0.28);
            }

    .row.g-4 > div:nth-child(1) .stat-card {
        animation-delay: .02s;
    }

    .row.g-4 > div:nth-child(2) .stat-card {
        animation-delay: .07s;
    }

    .row.g-4 > div:nth-child(3) .stat-card {
        animation-delay: .12s;
    }

    .row.g-4 > div:nth-child(4) .stat-card {
        animation-delay: .17s;
    }

    .row.g-4 > div:nth-child(5) .stat-card {
        animation-delay: .22s;
    }

    .row.g-4 > div:nth-child(6) .stat-card {
        animation-delay: .27s;
    }

    /* kpi mini-cards: the small "Revenue / Orders / Products…" tiles.
           Wider grid (3-up instead of 6-up) + generous internal room so the
           value and label are never clipped. */
    .kpi-card {
        min-height: 128px;
    }

        .kpi-card .card-body {
            padding: 1.5rem 1.6rem;
            height: 100%;
        }

    .kpi-body {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        min-width: 0;
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
        transition: transform .35s var(--ease);
    }

    .stat-card:hover .stat-icon {
        transform: scale(1.1) rotate(-5deg);
    }

    .stat-icon-1 {
        background: var(--brand-4);
        color: #3f6600;
    }

    .stat-icon-2 {
        background: var(--brand-3);
        color: #33500a;
    }

    .stat-icon-3 {
        background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
        color: #fff;
    }

    .stat-icon-4 {
        background: linear-gradient(135deg, var(--brand-2), var(--brand-2-dark));
        color: #fff;
    }

    .kpi-text {
        min-width: 0;
        flex: 1 1 auto;
    }

    .stat-value {
        font-family: var(--serif);
        font-variant-numeric: tabular-nums;
        font-size: clamp(1.3rem, 1vw + 1.05rem, 1.85rem);
        font-weight: 600;
        margin-bottom: .15rem;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--ink);
    }

    .stat-label {
        font-size: .76rem;
        color: var(--muted);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        white-space: normal;
        line-height: 1.35;
        overflow-wrap: break-word;
        display: block;
    }

    .stat-trend {
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
    }

    /* ================= progress + pipeline ================= */
    .progress-green {
        background-color: var(--brand-4);
        height: 8px;
        border-radius: 4px;
        overflow: hidden;
    }

        .progress-green .progress-bar {
            background: linear-gradient(90deg, var(--brand-2), var(--brand-1));
            border-radius: 4px;
            transition: width 1.1s var(--ease);
        }

    .status-row {
        display: flex;
        align-items: center;
        gap: .75rem;
        margin-bottom: .95rem;
        min-width: 0;
    }

        .status-row .status-label {
            width: 100px;
            font-size: .82rem;
            color: var(--muted-strong);
            font-weight: 500;
            flex-shrink: 0;
        }

        .status-row .status-count {
            width: 36px;
            text-align: right;
            font-weight: 700;
            font-size: .84rem;
            color: var(--ink);
            flex-shrink: 0;
            font-variant-numeric: tabular-nums;
        }

    .pipeline-bar {
        display: flex;
        width: 100%;
        height: 16px;
        border-radius: 9px;
        overflow: hidden;
        background: var(--brand-4);
        margin-bottom: 1.2rem;
        box-shadow: inset 0 1px 3px rgba(0,0,0,0.06);
    }

        .pipeline-bar span {
            height: 100%;
            transition: width .7s var(--ease), filter .2s ease;
            border-right: 1px solid rgba(255,255,255,0.5);
        }

            .pipeline-bar span:last-child {
                border-right: none;
            }

            .pipeline-bar span:hover {
                filter: brightness(0.93);
            }

    .pipeline-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .5rem;
    }

        .pipeline-legend .item {
            display: flex;
            align-items: center;
            gap: .4rem;
            font-size: .8rem;
            color: var(--muted-strong);
            min-width: 0;
            padding: .3rem .6rem;
            border-radius: 999px;
            border: 1px solid var(--canvas-line);
            transition: background .2s ease, border-color .2s ease;
        }

            .pipeline-legend .item:hover {
                background: var(--brand-4);
                border-color: var(--brand-3);
            }

        .pipeline-legend .swatch {
            width: 9px;
            height: 9px;
            border-radius: 3px;
            flex-shrink: 0;
        }

        .pipeline-legend .cnt {
            font-weight: 700;
            color: var(--ink);
        }

    /* ================= list rows ================= */
    .list-card .list-row {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .65rem .6rem;
        margin: 0 -.6rem;
        border-bottom: 1px dashed var(--canvas-line);
        min-width: 0;
        border-radius: 9px;
        transition: background .22s var(--ease), transform .22s var(--ease), padding-left .22s var(--ease);
        position: relative;
    }

        .list-card .list-row:last-child {
            border-bottom: none;
        }

        .list-card .list-row:hover {
            background: var(--brand-4);
            transform: translateX(2px);
            padding-left: .9rem;
        }

    .list-row-text {
        min-width: 0;
        flex: 1 1 auto;
    }

        .list-row-text .truncate {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
            color: var(--ink);
        }

    .rank-badge {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .74rem;
        font-weight: 700;
        color: #fff;
        background: var(--brand-2);
        flex-shrink: 0;
        transition: transform .25s var(--ease), background .25s ease;
    }

    .list-row:hover .rank-badge {
        transform: scale(1.15);
        background: var(--brand-1);
    }

    .mini-bar {
        height: 6px;
        border-radius: 3px;
        background: var(--brand-4);
        overflow: hidden;
        margin-top: .28rem;
    }

        .mini-bar > div {
            height: 100%;
            background: linear-gradient(90deg, var(--brand-2), var(--brand-1));
            transition: width .9s var(--ease);
        }

    .star-filled {
        color: var(--brand-1);
    }

    .star-empty {
        color: #d8e0d5;
    }

    /* ================= table ================= */
    .table-borderless thead tr th {
        color: var(--muted-strong);
        font-weight: 700;
        letter-spacing: .04em;
        border-bottom: 1px solid var(--canvas-line) !important;
        padding-bottom: .6rem;
    }

    .table-borderless tbody tr {
        transition: background .2s ease, transform .2s ease;
        border-radius: 9px;
    }

        .table-borderless tbody tr:hover {
            background: var(--brand-4);
        }

        .table-borderless tbody tr td {
            color: var(--ink);
        }

    /* ================= misc polish ================= */
    .card-title h5, h5.card-title, h5.text-nowrap {
        color: var(--ink);
        font-weight: 700;
    }

    .min-width-0 {
        min-width: 0;
    }

    .card.stat-card > .card-header {
        background: transparent;
    }

    @@media (max-width: 576px) {
        .stat-value {
            white-space: normal;
        }

        .stat-label {
            white-space: normal;
        }

        .status-row .status-label {
            width: 78px;
            font-size: .76rem;
        }

        .hero-band {
            padding: 1.5rem 1.25rem;
        }

        .hero-title {
            font-size: 1.35rem;
        }
    }

    /* ================= extra motion layer ================= */

    /* scroll-reveal: JS adds .reveal-pending on load, then .reveal-in as each
           element crosses into view. Without JS the original fadeInUp keyframe
           above still runs, so nothing is ever stuck invisible. */
    .reveal-pending {
        animation: none !important;
        opacity: 0;
        transform: translateY(26px);
        transition: opacity .7s var(--ease), transform .7s var(--ease);
    }

        .reveal-pending.reveal-in {
            opacity: 1;
            transform: translateY(0);
        }

    /* hero band: a slow light sweep on hover, like glass catching the light */
    .hero-band {
        isolation: isolate;
    }

        .hero-band .sweep {
            position: absolute;
            inset: 0;
            background: linear-gradient(100deg, transparent 40%, rgba(255,255,255,0.22) 50%, transparent 60%);
            transform: translateX(-120%);
            transition: transform .9s var(--ease);
            pointer-events: none;
            z-index: 1;
        }

        .hero-band:hover .sweep {
            transform: translateX(120%);
        }

    .hero-metric .lbl {
        position: relative;
        display: inline-block;
    }

        .hero-metric .lbl::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            bottom: -3px;
            height: 1px;
            background: rgba(255,255,255,0.7);
            transform: scaleX(0);
            transform-origin: left;
            transition: transform .3s var(--ease);
        }

    .hero-metric:hover .lbl::after {
        transform: scaleX(1);
    }

    /* stat-card icon: soft glow ring instead of a flat scale */
    .stat-icon {
        position: relative;
    }

    .stat-card:hover .stat-icon::after {
        content: '';
        position: absolute;
        inset: -5px;
        border-radius: 15px;
        border: 1.5px solid rgba(136,210,0,0.45);
        animation: ringPulse 1.1s var(--ease) infinite;
    }

    @@keyframes ringPulse {
        0% {
            opacity: .9;
            transform: scale(.9);
        }

        70% {
            opacity: 0;
            transform: scale(1.18);
        }

        100% {
            opacity: 0;
            transform: scale(1.18);
        }
    }

    /* progress bars: a light diagonal shine sweeps across on hover */
    .progress-green {
        position: relative;
    }

        .progress-green .progress-bar {
            position: relative;
            overflow: hidden;
        }

            .progress-green .progress-bar::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,0.55) 48%, transparent 66%);
                transform: translateX(-100%);
                transition: transform .8s var(--ease);
            }

    .status-row:hover .progress-bar::after {
        transform: translateX(100%);
    }

    /* pipeline segments: gentle grow + brighten on hover, handled already; add pop */
    .pipeline-bar span {
        transform-origin: center;
        transition: width .7s var(--ease), filter .2s ease, transform .2s ease;
    }

        .pipeline-bar span:hover {
            transform: scaleY(1.25);
            filter: brightness(0.95);
            z-index: 2;
            position: relative;
        }

    /* mini-bars: shine sweep on the parent row hover */
    .list-row .mini-bar {
        position: relative;
        overflow: hidden;
    }

        .list-row .mini-bar > div {
            position: relative;
            overflow: hidden;
        }

            .list-row .mini-bar > div::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(100deg, transparent 30%, rgba(255,255,255,0.5) 48%, transparent 66%);
                transform: translateX(-100%);
                transition: transform .7s var(--ease);
            }

    .list-row:hover .mini-bar > div::after {
        transform: translateX(100%);
    }

    /* star ratings: each star pops individually on hover */
    .bx.bxs-star {
        display: inline-block;
        transition: transform .2s var(--ease), color .2s ease;
    }

        .bx.bxs-star:hover {
            transform: scale(1.35) rotate(-6deg);
        }

    /* buttons + dropdown items: ripple on click, smoother open animation */
    .btn-outline-primary, .dropdown-item {
        position: relative;
        overflow: hidden;
    }

    .ripple {
        position: absolute;
        border-radius: 50%;
        background: rgba(136,210,0,0.35);
        transform: scale(0);
        animation: rippleAnim .6s ease-out;
        pointer-events: none;
    }

    @@keyframes rippleAnim {
        to {
            transform: scale(2.6);
            opacity: 0;
        }
    }

    .dropdown-menu {
        border: 1px solid var(--canvas-line);
        box-shadow: 0 16px 34px -10px rgba(90,120,40,0.25);
        border-radius: 10px;
        transform-origin: top right;
        animation: dropdownIn .18s var(--ease);
    }

    @@keyframes dropdownIn {
        from {
            opacity: 0;
            transform: scale(.92) translateY(-6px);
        }

        to {
            opacity: 1;
            transform: scale(1) translateY(0);
        }
    }

    .dropdown-item {
        border-radius: 6px;
        margin: 1px 4px;
        width: calc(100% - 8px);
        transition: background .18s ease, color .18s ease, padding-left .18s ease;
    }

        .dropdown-item:hover {
            background: var(--brand-4);
            color: var(--brand-2-dark);
            padding-left: 1.15rem;
        }

    /* badges: small lift + glow on hover */
    .badge {
        transition: transform .2s var(--ease), box-shadow .2s ease;
    }

        .badge:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(111,168,0,0.25);
        }

    /* table rows: slight scale + left accent bar on hover */
    .table-borderless tbody tr {
        border-left: 2px solid transparent;
        transition: background .2s ease, border-color .2s ease, transform .15s ease;
    }

        .table-borderless tbody tr:hover {
            border-left-color: var(--brand-1);
            transform: translateX(2px);
        }

    /* avatar icons in list rows: gentle hover bounce */
    .avatar-initial {
        transition: transform .25s var(--ease);
    }

    .list-row:hover .avatar-initial {
        transform: translateY(-2px) scale(1.06);
    }

    @@media (prefers-reduced-motion: reduce) {
        .reveal-pending {
            opacity: 1 !important;
            transform: none !important;
        }
    }

    /* ================= layer three: spotlight, magnetism, finishing touches ================= */

    html {
        scroll-behavior: smooth;
    }

    @@media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }
    }

    /* cursor-tracked glow inside stat cards, added as a real child by JS */
    .stat-card {
        isolation: isolate;
    }

        .stat-card .spotlight {
            position: absolute;
            inset: 0;
            border-radius: inherit;
            background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), rgba(136,210,0,0.14), transparent 68%);
            opacity: 0;
            transition: opacity .35s ease;
            pointer-events: none;
            z-index: 0;
        }

        .stat-card:hover .spotlight {
            opacity: 1;
        }

        .stat-card .card-body, .stat-card .card-header {
            position: relative;
            z-index: 1;
        }

    /* magnetic pull on primary controls */
    .btn-outline-primary {
        transition: transform .18s ease-out, background-color .2s ease, box-shadow .2s ease;
    }

    /* the winning entry in a leaderboard gets a slow confident glow */
    .list-card .list-row:first-child .rank-badge {
        background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
        animation: badgeGlow 2.6s ease-in-out infinite;
    }

    @@keyframes badgeGlow {
        0%, 100% {
            box-shadow: 0 0 0 0 rgba(136,210,0,0.45);
        }

        50% {
            box-shadow: 0 0 0 7px rgba(136,210,0,0);
        }
    }

    /* section icon gives a little wiggle when you hover the heading */
    .section-title i {
        transition: transform .2s ease;
    }

    .section-title:hover i {
        animation: iconWiggle .5s ease;
    }

    @@keyframes iconWiggle {
        0%, 100% {
            transform: rotate(0deg);
        }

        25% {
            transform: rotate(-14deg);
        }

        75% {
            transform: rotate(14deg);
        }
    }

    /* floating back-to-top control, created by script */
    .back-to-top {
        position: fixed;
        right: 22px;
        bottom: 22px;
        z-index: 999;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        border: none;
        background: linear-gradient(135deg, var(--brand-1), var(--brand-2));
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 10px 24px rgba(111,168,0,0.38);
        cursor: pointer;
        opacity: 0;
        transform: translateY(18px) scale(.8);
        pointer-events: none;
        transition: opacity .3s var(--ease), transform .3s var(--ease), box-shadow .2s ease;
    }

        .back-to-top.show {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: auto;
        }

        .back-to-top:hover {
            transform: translateY(-4px) scale(1.08);
            box-shadow: 0 14px 30px rgba(111,168,0,0.48);
        }

        .back-to-top i {
            font-size: 1.3rem;
        }

    @@media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        .back-to-top, .list-card .list-row:first-child .rank-badge {
            animation: none !important;
            transition: opacity .2s ease;
        }
    }
</style>

<div class="content-wrapper">
    <div class="container-xxl flex-grow-1 container-p-y">

        <!-- ============ HERO BAND ============ -->
