                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-4">
                <div class="card stat-card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div class="stat-icon stat-icon-1"><i class="bx bx-cart"></i></div>
                        <div class="kpi-text">
                            <p class="stat-value">@totalOrders</p>
                            <span class="stat-label">Total Orders</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-4">
                <div class="card stat-card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div class="stat-icon stat-icon-2"><i class="bx bx-package"></i></div>
                        <div class="kpi-text">
                            <p class="stat-value">@totalProducts</p>
                            <span class="stat-label">Total Products</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-lg-4">
                <div class="card stat-card kpi-card h-100">
                    <div class="card-body kpi-body">
                        <div class="stat-icon stat-icon-4"><i class="bx bx-user"></i></div>
