    <script>
        (function () {
            var navbar = document.getElementById('layout-navbar');
            var scrollHost = document.querySelector('.layout-page') || window;
            function toggleShadow() {
                var scrollTop = scrollHost === window ? window.scrollY : scrollHost.scrollTop;
                navbar.classList.toggle('navbar-scrolled', scrollTop > 8);
            }
            scrollHost.addEventListener('scroll', toggleShadow);
            toggleShadow();
        })();
    </script>

    <script>
        // ================================================================
        // NAVBAR LIVE SEARCH
        // Calls Admin/GlobalSearch (JSON) and renders a grouped, clickable
        // results panel under the search pill. Ctrl/Cmd+K focuses it,
        // arrow keys move through results, Enter opens the highlighted one,
        // Escape closes it.
        // ================================================================
        (function () {
            var wrap = document.querySelector('.navbar-search-wrap');
            var input = document.querySelector('.navbar-search-pill input');
            if (!wrap || !input) return;

            var panel = document.createElement('div');
            panel.className = 'navbar-search-results';
            wrap.appendChild(panel);

            var debounceTimer = null;
            var activeController = null;
            var activeIndex = -1;

            var GROUPS = [
                { key: 'products', label: 'Products', icon: 'bx-image' },
                { key: 'customers', label: 'Customers', icon: 'bx-user' },
                { key: 'orders', label: 'Orders', icon: 'bx-cart' },
                { key: 'categories', label: 'Categories', icon: 'bx-category-alt' }
            ];

            function escapeHtml(value) {
                var div = document.createElement('div');
                div.textContent = value === null || value === undefined ? '' : String(value);
                return div.innerHTML;
            }

            function openPanel() {
                panel.classList.add('show');
            }

            function closePanel() {
                panel.classList.remove('show');
                activeIndex = -1;
            }

            function showLoading() {
                panel.innerHTML = '<div class="search-loading-state"><i class="bx bx-loader-alt"></i>Searching…</div>';
                openPanel();
            }

            function showEmpty() {
                panel.innerHTML = '<div class="search-empty-state">No matches found</div>';
            }

            function render(data) {
                var html = '';
                var total = 0;

                GROUPS.forEach(function (group) {
                    var items = (data && data[group.key]) || [];
                    if (items.length === 0) return;
                    total += items.length;
                    html += '<div class="search-group-label">' + group.label + '</div>';
                    items.forEach(function (item) {
                        html += '<a class="search-result-item" href="' + escapeHtml(item.url) + '">' +
                            '<span class="search-result-icon"><i class="bx ' + group.icon + '"></i></span>' +
                            '<span class="search-result-text">' +
                            '<span class="search-result-title">' + escapeHtml(item.label) + '</span>' +
                            (item.sub ? '<span class="search-result-sub">' + escapeHtml(item.sub) + '</span>' : '') +
                            '</span></a>';
                    });
                });

                if (total === 0) {
                    showEmpty();
                    return;
                }

                panel.innerHTML = html;
                activeIndex = -1;
            }

            function runSearch(term) {
                showLoading();
                if (activeController) activeController.abort();
                activeController = new AbortController();

                fetch('/Admin/GlobalSearch?term=' + encodeURIComponent(term), { signal: activeController.signal })
                    .then(function (response) { return response.json(); })
                    .then(render)
                    .catch(function (err) {
                        if (err.name !== 'AbortError') {
                            panel.innerHTML = '<div class="search-empty-state">Something went wrong. Try again.</div>';
                        }
                    });
            }

            input.addEventListener('input', function () {
                var term = input.value.trim();
                clearTimeout(debounceTimer);

                if (term.length < 2) {
                    closePanel();
                    return;
                }

                debounceTimer = setTimeout(function () { runSearch(term); }, 250);
            });

            input.addEventListener('focus', function () {
                if (input.value.trim().length >= 2 && panel.innerHTML.trim() !== '') {
                    openPanel();
                }
            });

            document.addEventListener('click', function (e) {
                if (!wrap.contains(e.target)) closePanel();
            });

            input.addEventListener('keydown', function (e) {
                var items = panel.querySelectorAll('.search-result-item');

                if (e.key === 'Escape') {
                    closePanel();
                    input.blur();
                    return;
                }

                if (e.key === 'ArrowDown' && items.length) {
                    e.preventDefault();
                    activeIndex = Math.min(activeIndex + 1, items.length - 1);
                    items.forEach(function (el, i) { el.classList.toggle('is-active', i === activeIndex); });
                    items[activeIndex].scrollIntoView({ block: 'nearest' });
                    return;
                }

                if (e.key === 'ArrowUp' && items.length) {
                    e.preventDefault();
                    activeIndex = Math.max(activeIndex - 1, 0);
                    items.forEach(function (el, i) { el.classList.toggle('is-active', i === activeIndex); });
                    items[activeIndex].scrollIntoView({ block: 'nearest' });
                    return;
                }

                if (e.key === 'Enter') {
                    var target = activeIndex >= 0 && items[activeIndex] ? items[activeIndex] : items[0];
                    if (target) {
                        e.preventDefault();
                        window.location.href = target.getAttribute('href');
                    }
                }
            });

            // Ctrl/Cmd+K focuses the navbar search from anywhere on the page
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    input.focus();
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
