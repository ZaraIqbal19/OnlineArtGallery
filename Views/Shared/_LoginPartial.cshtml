@using Microsoft.AspNetCore.Identity
@using Art_Gallery.Areas.Identity.Data
@inject SignInManager<Art_GalleryUser> SignInManager
@inject UserManager<Art_GalleryUser> UserManager
@if (SignInManager.IsSignedIn(User))
{
    var currentUser = await UserManager.GetUserAsync(User);
    var displayName = currentUser?.UserName ?? "Account";
    var initial = !string.IsNullOrEmpty(displayName) ? displayName.Substring(0, 1).ToUpper() : "U";
    <li class="user-menu">
        <a href="#" class="user-menu-trigger">
            <span class="user-avatar-wrap">
                <span class="user-avatar">@initial</span>
                <span class="user-status-dot"></span>
            </span>
            <span class="user-name">@displayName</span>
            <i class="fa fa-angle-down user-caret"></i>
        </a>
        <!-- Pure CSS hover dropdown — opacity/visibility/position are all
             defined on ".user-dropdown" itself in _Layout.cshtml, and
             revealed via ".user-menu:hover .user-dropdown". No JS needed,
             so there's no external script to conflict with this markup. -->
        <ul class="user-dropdown">
            <li class="user-dropdown-header">
                <span class="user-avatar user-avatar-lg">@initial</span>
                <div>
                    <strong>@displayName</strong>
                    <small>@currentUser?.Email</small>
                </div>
            </li>
            <li class="user-dropdown-links">
                <ul>
                    <li><a asp-controller="User" asp-action="Myprofile"><i class="fa fa-user-o"></i> My Profile</a></li>
                    <li><a asp-controller="User" asp-action="Myproducts"><i class="fa fa-cube"></i> My Products</a></li>
                    <li><a asp-controller="User" asp-action="Myorders"><i class="fa fa-shopping-bag"></i> My Orders</a></li>
                    <li><a asp-controller="User" asp-action="Mywishlist"><i class="fa fa-heart-o"></i> Wishlist</a></li>
                    <li><a asp-controller="User" asp-action="Userallbids"><i class="fa fa-gavel"></i> My Bids</a></li>
                    <li><a asp-controller="User" asp-action="Addpaymentdetails"><i class="fa fa-credit-card"></i> Payment Details</a></li>
                    <li><a asp-controller="User" asp-action="ChangePassword"><i class="fa fa-lock"></i> Change Password</a></li>
                </ul>
            </li>
            <li class="logout-footer">
                <form id="logoutForm" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "User")" method="post">
                    <button type="submit" class="logout-btn">
                        <span class="logout-icon"><i class="fa fa-sign-out"></i></span>
                        Logout
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="auth-buttons">
        <a asp-area="Identity" asp-page="/Account/Login" class="btn-nav btn-nav-outline">Login</a>
        <a asp-area="Identity" asp-page="/Account/Register" class="btn-nav btn-nav-solid">Register</a>
    </li>
}
