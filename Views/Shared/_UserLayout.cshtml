                        </li>

                        <li>
                            <a href="#"><i class="fa fa-user-circle-o"></i> My Account <i class="fa fa-angle-down caret"></i></a>
                            <ul class="sub-menu">
                                <li><a asp-controller="User" asp-action="Myprofile"><i class="fa fa-user-o"></i> My Profile</a></li>
                                <li><a asp-controller="User" asp-action="Myproducts"><i class="fa fa-cube"></i> My Products</a></li>
                                <li><a asp-controller="User" asp-action="Myorders"><i class="fa fa-shopping-bag"></i> My Orders</a></li>
