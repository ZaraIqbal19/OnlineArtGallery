                            </ul>
                        </li>

                        <li>
                            <a href="#"><i class="fa fa-line-chart"></i> Selling <i class="fa fa-angle-down caret"></i></a>
                            <ul class="sub-menu">
                                <li><a asp-controller="User" asp-action="Usersellerprofile"><i class="fa fa-dashboard"></i> Seller Dashboard</a></li>
                                <li><a asp-controller="User" asp-action="Myproductsorders"><i class="fa fa-inbox"></i> Orders on My Products</a></li>
                                <li><a asp-controller="User" asp-action="Myauctionproductsbids"><i class="fa fa-gavel"></i> Bids on My Auctions</a></li>
                            </ul>
                        </li>

                        <li>
                            <a href="#"><i class="fa fa-ellipsis-h"></i> More <i class="fa fa-angle-down caret"></i></a>
                            <ul class="sub-menu">
                                <li><a asp-controller="User" asp-action="Addcontact"><i class="fa fa-envelope-o"></i> Contact</a></li>
                                <li><a asp-controller="User" asp-action="Adduserfeedback"><i class="fa fa-comment-o"></i> Give Feedback</a></li>
                                <li><a asp-controller="User" asp-action="Allusersfeedbacks"><i class="fa fa-comments-o"></i> All Feedbacks</a></li>
                            </ul>
